<Window x:Class="ProGlassAutomation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:studio="clr-namespace:ProGlassAutomation.ThemeStudio"
        Title="ProGlass" Height="1000" Width="1700"
        MinHeight="{DynamicResource WindowMinHeight}" MinWidth="{DynamicResource WindowMinWidth}"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Style="{DynamicResource ThemedWindow}"
        Background="{DynamicResource ApplicationBackground}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        WindowStyle="SingleBorderWindow"
        AllowsTransparency="False"
        ResizeMode="CanResizeWithGrip"
        Focusable="True"
        ShowInTaskbar="True">
    <Window.Resources>
        <Style x:Key="ShellTopBar" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfacePrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="{DynamicResource PaddingCompact}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMenuOpen}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ShellSidebar" TargetType="Border">
            <Setter Property="Width" Value="{DynamicResource StudioSidebarWidth}" />
            <Setter Property="Background" Value="{DynamicResource SurfacePrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
            <Setter Property="Margin" Value="{DynamicResource PaddingPage}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMenuOpen}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ShellIconButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{DynamicResource KeyboardFocus}" />
            <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Padding" Value="{DynamicResource PaddingCompact}" />
            <Setter Property="MinHeight" Value="{DynamicResource ControlMinHeight}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="{DynamicResource ChipCornerRadius}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource StateHover}" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ShellNavButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{DynamicResource KeyboardFocus}" />
            <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="{DynamicResource PaddingControl}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Row" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="{DynamicResource ChipCornerRadius}">
                    <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" RecognizesAccessKey="True" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource StateHover}" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ShellGroupToggle" TargetType="ToggleButton">
            <Setter Property="FocusVisualStyle" Value="{DynamicResource KeyboardFocus}" />
            <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="{DynamicResource PaddingControl}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
                <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                    <DockPanel>
                        <TextBlock x:Name="Chevron" DockPanel.Dock="Right" Text="▾" Foreground="{DynamicResource TextMuted}" />
                        <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </DockPanel>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="False"><Setter TargetName="Chevron" Property="Text" Value="▸" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ShellSectionLabel" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Margin" Value="{DynamicResource PaddingCompact}" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="{DynamicResource PaddingPage}" Panel.ZIndex="2"
                Background="{DynamicResource SurfacePrimary}" BorderBrush="{DynamicResource AccentPrimary}" BorderThickness="{DynamicResource BorderThicknessControl}"
                CornerRadius="{DynamicResource ChipCornerRadius}" Padding="{DynamicResource PaddingCompact}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsMenuOpen}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Button Command="{Binding ToggleMenu}" Style="{StaticResource ShellIconButton}" AutomationProperties.Name="Open shell">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="☰" Margin="{DynamicResource MarginInline}" />
                    <TextBlock Text="{Binding WorkspaceTitle}" FontWeight="{DynamicResource FontWeightHeading}" />
                </StackPanel>
            </Button>
        </Border>
        <Border Grid.Row="0" Style="{StaticResource ShellTopBar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="☰" Command="{Binding ToggleMenu}" Style="{StaticResource ShellIconButton}" ToolTip="Hide menu" AutomationProperties.Name="Toggle menu" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="{DynamicResource MarginInline}">
                    <TextBlock Text="ProGlass" FontSize="{DynamicResource FontSizeTitle}" FontWeight="{DynamicResource FontWeightHeading}" VerticalAlignment="Center" />
                    <TextBlock Text="AUTOMATION SUITE" Style="{DynamicResource Caption}" VerticalAlignment="Bottom" Margin="{DynamicResource MarginInline}" />
                </StackPanel>
                <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{Binding WorkspaceTitle}" FontWeight="{DynamicResource FontWeightHeading}" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding WorkspaceSubtitle}" Style="{DynamicResource Caption}" HorizontalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ShellClock}" Style="{DynamicResource Caption}" VerticalAlignment="Center" Margin="{DynamicResource MarginInline}" />
                    <Button Content="Dark" Command="{Binding ToggleAppearance}" Style="{StaticResource ShellIconButton}" AutomationProperties.Name="Toggle appearance" />
                    <Button Command="{Binding ShowStudio}" Style="{StaticResource ShellIconButton}" AutomationProperties.Name="Settings" ToolTip="Settings">
                        <TextBlock Text="Settings" />
                    </Button>
                    <Border Width="{DynamicResource ControlMinHeight}" Height="{DynamicResource ControlMinHeight}" CornerRadius="{DynamicResource ControlCornerRadius}" Background="{DynamicResource AccentSoft}" Margin="{DynamicResource MarginInline}" VerticalAlignment="Center">
                        <TextBlock Text="U" Foreground="{DynamicResource AccentPrimary}" FontWeight="{DynamicResource FontWeightHeading}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="User" FontSize="{DynamicResource FontSizeCaption}" />
                        <TextBlock Text="Role" Style="{DynamicResource Caption}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource ShellSidebar}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="{DynamicResource PaddingCompact}">
                        <Button DockPanel.Dock="Right" Content="✕" Command="{Binding ToggleMenu}" Style="{StaticResource ShellIconButton}" AutomationProperties.Name="Close menu" />
                        <TextBlock Text="Menu" FontWeight="{DynamicResource FontWeightHeading}" VerticalAlignment="Center" />
                    </DockPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <StackPanel>
                            <ToggleButton x:Name="SettingsGroup" Style="{StaticResource ShellGroupToggle}" Content="Settings" IsChecked="True" />
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsChecked, ElementName=SettingsGroup}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Button Command="{Binding ShowStudio}" AutomationProperties.Name="Theme Studio page">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource ShellNavButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsStudio}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource AccentPrimary}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource TextOnAccent}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <TextBlock Text="Theme Studio" />
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                    <TextBlock Grid.Row="2" Text="Phase 01 · Theme engine" Style="{StaticResource ShellSectionLabel}" />
                </Grid>
            </Border>
            <TabControl Grid.Column="1" x:Name="WorkspaceTabs"
                        SelectedIndex="{Binding SelectedWorkspace, Mode=TwoWay}"
                        AutomationProperties.Name="Design workspace pages"
                        Background="{DynamicResource ApplicationBackground}"
                        BorderThickness="0"
                        ClipToBounds="True">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </Style>
                </TabControl.Resources>
                <TabItem Header="_Theme Studio"><studio:ThemeStudioView /></TabItem>
                <TabItem Header="_Home"><studio:BusinessReferenceView /></TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
