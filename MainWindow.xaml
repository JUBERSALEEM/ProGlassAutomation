<Window x:Class="ProGlassAutomation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:studio="clr-namespace:ProGlassAutomation.ThemeStudio"
        xmlns:bento="clr-namespace:ProGlassAutomation.ThemeBento"
        Title="ProGlass — Bento Theme Studio" Height="1000" Width="1700"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Style="{DynamicResource ThemedWindow}"
        Background="{DynamicResource ApplicationBackground}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        WindowStyle="SingleBorderWindow"
        AllowsTransparency="False"
        ResizeMode="CanResizeWithGrip"
        Focusable="True"
        ShowInTaskbar="True">
    <bento:BentoGrid Columns="4" FillAvailable="True"
                     RowHeight="{DynamicResource BentoRowHeight}"
                     Gutter="{DynamicResource BentoGutter}"
                     CompactWidth="{DynamicResource BentoCompactWidth}"
                     Margin="{DynamicResource PaddingPage}">
        <Border Style="{DynamicResource Card}" bento:BentoGrid.Column="0" bento:BentoGrid.Row="0">
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <Border Width="{DynamicResource ControlMinHeight}" Height="{DynamicResource ControlMinHeight}" CornerRadius="{DynamicResource ControlCornerRadius}" Background="{DynamicResource AccentPrimary}" VerticalAlignment="Center">
                    <TextBlock Text="PG" Foreground="{DynamicResource TextOnAccent}" FontWeight="{DynamicResource FontWeightHeading}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="{DynamicResource MarginInline}" VerticalAlignment="Center">
                    <TextBlock Text="ProGlass Bento" FontWeight="{DynamicResource FontWeightHeading}"/>
                    <TextBlock Text="Theme Engine Studio" Style="{DynamicResource Caption}"/>
                </StackPanel>
            </StackPanel>
        </Border>
        <Border Style="{DynamicResource AccentPlate}" bento:BentoGrid.Column="1" bento:BentoGrid.Row="0" bento:BentoGrid.ColumnSpan="2">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton Content="Theme Studio" IsChecked="{Binding IsStudio}" GroupName="Workspace" AutomationProperties.Name="Theme Studio page" Margin="{DynamicResource MarginInline}"/>
                <RadioButton Content="Business Reference" IsChecked="{Binding IsBusiness}" GroupName="Workspace" AutomationProperties.Name="Business Reference page"/>
            </StackPanel>
        </Border>
        <Border Style="{DynamicResource Card}" bento:BentoGrid.Column="3" bento:BentoGrid.Row="0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton Content="Light" IsChecked="{Binding IsLight}" GroupName="ShellAppearance" AutomationProperties.Name="Light appearance" VerticalAlignment="Center" Margin="{DynamicResource MarginInline}"/>
                <RadioButton Content="Dark" IsChecked="{Binding IsDark}" GroupName="ShellAppearance" AutomationProperties.Name="Dark appearance" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
        <TabControl x:Name="WorkspaceTabs" bento:BentoGrid.Column="0" bento:BentoGrid.Row="1" bento:BentoGrid.ColumnSpan="4" bento:BentoGrid.RowSpan="3"
                    SelectedIndex="{Binding SelectedWorkspace, Mode=TwoWay}" AutomationProperties.Name="Design workspace pages"
                    Background="{DynamicResource ApplicationBackground}" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Style>
            </TabControl.Resources>
            <TabItem Header="_Theme Studio"><studio:ThemeStudioView /></TabItem>
            <TabItem Header="_Business Reference"><studio:BusinessReferenceView /></TabItem>
        </TabControl>
    </bento:BentoGrid>
</Window>
