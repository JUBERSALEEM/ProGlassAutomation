<Window x:Class="ProGlassAutomation.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:studio="clr-namespace:ProGlassAutomation.ThemeStudio"
 Title="ProGlass V3.0 · Theme Studio" Width="{DynamicResource WindowInitialWidth}" Height="{DynamicResource WindowInitialHeight}"
 MinWidth="{DynamicResource WindowMinWidth}" MinHeight="{DynamicResource WindowMinHeight}"
 WindowState="Maximized" WindowStartupLocation="CenterScreen" Style="{DynamicResource ThemedWindow}">
 <TabControl x:Name="WorkspaceTabs" SelectedIndex="{Binding SelectedWorkspace, Mode=TwoWay}" AutomationProperties.Name="Design workspace pages">
  <TabItem Header="_Theme Studio"><studio:ThemeStudioView /></TabItem>
  <TabItem Header="_Business Reference"><studio:BusinessReferenceView /></TabItem>
 </TabControl>
</Window>
