<Window x:Class="ProGlassAutomation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:studio="clr-namespace:ProGlassAutomation.ThemeStudio"
        Title="ProGlass" Height="1000" Width="1700"
        MinHeight="{DynamicResource WindowMinHeight}" MinWidth="{DynamicResource WindowMinWidth}"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Style="{DynamicResource ThemedWindow}"
        Background="{DynamicResource ApplicationBackground}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        WindowStyle="SingleBorderWindow"
        AllowsTransparency="False"
        ResizeMode="CanResizeWithGrip"
        Focusable="True"
        ShowInTaskbar="True">
    <Window.Resources>
        <Style x:Key="ShellSidebar" TargetType="Border">
            <Setter Property="Width" Value="{DynamicResource StudioSidebarWidth}" />
            <Setter Property="Background" Value="{DynamicResource SurfacePrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="0,0,1,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMenuOpen}" Value="False">
                    <Setter Property="Width" Value="0" />
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ShellIconButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{DynamicResource KeyboardFocus}" />
            <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Padding" Value="{DynamicResource PaddingCompact}" />
            <Setter Property="MinHeight" Value="{DynamicResource ControlMinHeight}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="{DynamicResource ChipCornerRadius}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource StateHover}" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ShellNavButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{DynamicResource KeyboardFocus}" />
            <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="{DynamicResource PaddingControl}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Row" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="{DynamicResource ChipCornerRadius}">
                    <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" RecognizesAccessKey="True" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource StateHover}" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ShellExpanderCard" TargetType="Expander">
            <Setter Property="Background" Value="{DynamicResource SurfaceElevated}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="{DynamicResource BorderThicknessControl}" />
            <Setter Property="Padding" Value="{DynamicResource PaddingCompact}" />
            <Setter Property="Margin" Value="{DynamicResource MarginItem}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource KeyboardFocus}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource ControlCornerRadius}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition x:Name="ContentRow" Height="0" />
                                </Grid.RowDefinitions>
                                <ToggleButton Grid.Row="0" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Content="{TemplateBinding Header}" Background="{DynamicResource TransparentBrush}" BorderThickness="0" Padding="{DynamicResource PaddingControl}" Cursor="Hand" FocusVisualStyle="{DynamicResource KeyboardFocus}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="{DynamicResource ChipCornerRadius}">
                                                <DockPanel>
                                                    <TextBlock x:Name="Arrow" DockPanel.Dock="Right" Text="▾" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                                                    <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
                                                </DockPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="False"><Setter TargetName="Arrow" Property="Text" Value="▸" /></Trigger>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource StateHover}" /></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <Border Grid.Row="1" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,1,0,0" Padding="{DynamicResource PaddingCompact}">
                                    <ContentPresenter />
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ContentRow" Property="Height" Value="Auto" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ShellSectionLabel" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Margin" Value="{DynamicResource PaddingCompact}" />
        </Style>
        <Style x:Key="ShellModuleBanner" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource AccentPrimary}" />
            <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
            <Setter Property="Padding" Value="{DynamicResource PaddingControl}" />
            <Setter Property="Margin" Value="{DynamicResource PaddingPage}" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid x:Name="ShellBody">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource ShellSidebar}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel Margin="{DynamicResource PaddingCompact}">
                    <Button DockPanel.Dock="Right" Content="◀◀" Command="{Binding ToggleMenu}" Style="{StaticResource ShellIconButton}" ToolTip="Hide menu" AutomationProperties.Name="Close menu" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="{DynamicResource ControlMinHeight}" Height="{DynamicResource ControlMinHeight}" CornerRadius="{DynamicResource ChipCornerRadius}" Background="{DynamicResource AccentSoft}" Margin="{DynamicResource MarginInline}" VerticalAlignment="Center">
                            <TextBlock Text="PG" Foreground="{DynamicResource AccentPrimary}" FontWeight="{DynamicResource FontWeightHeading}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="ProGlass" FontWeight="{DynamicResource FontWeightHeading}" />
                            <TextBlock Text="Automation" Style="{DynamicResource Caption}" />
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel>
                        <Button Command="{Binding ShowBusiness}" AutomationProperties.Name="Home page" Margin="{DynamicResource MarginItem}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ShellNavButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBusiness}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AccentPrimary}" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextOnAccent}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="Home" />
                        </Button>
                        <Expander x:Name="SettingsGroup" Style="{StaticResource ShellExpanderCard}" IsExpanded="True" AutomationProperties.Name="Settings">
                            <Expander.Header>
                                <TextBlock Text="Settings" FontWeight="{DynamicResource FontWeightHeading}" />
                            </Expander.Header>
                            <Button Command="{Binding ShowStudio}" AutomationProperties.Name="Theme Studio page">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ShellNavButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsStudio}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource AccentPrimary}" />
                                                <Setter Property="Foreground" Value="{DynamicResource TextOnAccent}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="Theme Studio" />
                            </Button>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
                <TextBlock Grid.Row="2" Text="Phase 01 · Theme engine" Style="{StaticResource ShellSectionLabel}" />
            </Grid>
        </Border>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Style="{StaticResource ShellModuleBanner}">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Width="{DynamicResource ControlMinHeight}" Margin="{DynamicResource MarginInline}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMenuOpen}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                    <ContentControl DockPanel.Dock="Right" Style="{DynamicResource Card}" Margin="{DynamicResource MarginInline}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ShellClock}" Style="{DynamicResource Caption}" VerticalAlignment="Center" Margin="{DynamicResource MarginInline}" />
                            <Button Content="Home" Command="{Binding ShowBusiness}" Style="{StaticResource ShellIconButton}" ToolTip="Home" AutomationProperties.Name="Go home" />
                            <Button Content="Dark" Command="{Binding ToggleAppearance}" Style="{StaticResource ShellIconButton}" AutomationProperties.Name="Toggle appearance" />
                        </StackPanel>
                    </ContentControl>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding WorkspaceTitle}" Foreground="{DynamicResource TextOnAccent}" FontSize="{DynamicResource FontSizeTitle}" FontWeight="{DynamicResource FontWeightHeading}" />
                        <TextBlock Text="{Binding WorkspaceSubtitle}" Foreground="{DynamicResource TextOnAccent}" Style="{DynamicResource Caption}" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <TabControl Grid.Row="1" x:Name="WorkspaceTabs"
                        SelectedIndex="{Binding SelectedWorkspace, Mode=TwoWay}"
                        AutomationProperties.Name="Design workspace pages"
                        Background="{DynamicResource ApplicationBackground}"
                        BorderThickness="0"
                        ClipToBounds="True">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </Style>
                </TabControl.Resources>
                <TabItem Header="_Theme Studio"><studio:ThemeStudioView /></TabItem>
                <TabItem Header="_Home"><studio:BusinessReferenceView /></TabItem>
            </TabControl>
        </Grid>
        <Button Grid.ColumnSpan="2" HorizontalAlignment="Left" VerticalAlignment="Top" Content="☰" Command="{Binding ToggleMenu}" ToolTip="Open menu" AutomationProperties.Name="Toggle menu" Panel.ZIndex="2" Margin="{DynamicResource PaddingPage}">
            <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource ShellIconButton}">
                    <Setter Property="Foreground" Value="{DynamicResource TextOnAccent}" />
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsMenuOpen}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
        </Grid>
        <Border x:Name="SpotlightScrim" Background="{DynamicResource ApplicationBackground}" Opacity="0.45" Visibility="Collapsed" IsHitTestVisible="True" />
    </Grid>
</Window>
