<UserControl x:Class="ProGlassAutomation.ThemeStudio.SurfacesPanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ContentControl Style="{DynamicResource Card}">
  <Grid>
   <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="*"/>
   </Grid.RowDefinitions>
   <StackPanel>
    <TextBlock Text="TEAM HANDOFF / SAMPLE" Style="{DynamicResource Caption}" />
    <TextBlock Text="Next in the workflow." Style="{DynamicResource SectionHeading}" />
   </StackPanel>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
    <StackPanel>
     <WrapPanel>
      <ContentControl Style="{DynamicResource Plate}" Margin="{DynamicResource MarginInline}"><StackPanel><TextBlock Text="Review brief" FontWeight="{DynamicResource FontWeightHeading}" /><TextBlock Text="Scope and priorities" Style="{DynamicResource Caption}" /></StackPanel></ContentControl>
      <ContentControl Style="{DynamicResource ElevatedPlate}" Margin="{DynamicResource MarginInline}"><StackPanel><TextBlock Text="Quality check" FontWeight="{DynamicResource FontWeightHeading}" /><TextBlock Text="Details before delivery" Style="{DynamicResource Caption}" /></StackPanel></ContentControl>
      <ContentControl Style="{DynamicResource AccentPlate}" Margin="{DynamicResource MarginInline}"><StackPanel><TextBlock Text="Handoff" Foreground="{DynamicResource AccentPrimary}" FontWeight="{DynamicResource FontWeightHeading}" /><TextBlock Text="Team alignment" Style="{DynamicResource Caption}" /></StackPanel></ContentControl>
     </WrapPanel>
     <TextBlock Text="Selection / use arrows to move between rows" Style="{DynamicResource Caption}" Margin="{DynamicResource MarginItem}" />
     <ListBox SelectedIndex="0" VirtualizingPanel.IsVirtualizing="False" AutomationProperties.Name="Surface selection examples">
      <ListBoxItem Content="Primary surface — main working area" />
      <ListBoxItem Content="Secondary surface — grouped supporting information" />
      <ListBoxItem Content="Quality check — dialogs and contextual actions" />
     </ListBox>
    </StackPanel>
   </ScrollViewer>
  </Grid>
 </ContentControl>
</UserControl>
