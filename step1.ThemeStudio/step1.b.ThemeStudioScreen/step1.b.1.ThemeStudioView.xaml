<UserControl x:Class="ProGlassAutomation.ThemeStudio.ThemeStudioView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ProGlassAutomation.ThemeStudio">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="{DynamicResource PaddingPage}">
  <DockPanel Margin="{DynamicResource MarginSection}"><StackPanel><TextBlock Text="PROGLASS / BENTO DESIGN WORKSPACE" Style="{DynamicResource Caption}" /><TextBlock Text="Theme Studio" Style="{DynamicResource PageHeading}" /><TextBlock Text="Customize the system, not individual screens." Foreground="{DynamicResource TextSecondary}" /></StackPanel></DockPanel>
  <Border Style="{DynamicResource HeroCard}" Margin="{DynamicResource MarginSection}"><DockPanel>
   <Button DockPanel.Dock="Right" Content="Business reference →" Command="{Binding ShowBusiness}" Margin="{DynamicResource MarginInline}" VerticalAlignment="Center" />
   <StackPanel><TextBlock Text="Make it yours. Keep it consistent." FontSize="{DynamicResource FontSizeTitle}" FontWeight="{DynamicResource FontWeightHeading}" Foreground="{DynamicResource HeroForeground}" /><TextBlock Text="{Binding DesignSummary}" Foreground="{DynamicResource HeroSecondaryText}" /><TextBlock Text="{Binding AppearanceLabel, StringFormat='Bento {0} / live application resources'}" Foreground="{DynamicResource HeroSecondaryText}" /></StackPanel>
  </DockPanel></Border>
  <Grid x:Name="Modules" SizeChanged="Modules_SizeChanged">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
   <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
   <local:CustomizationPanel x:Name="Settings" Width="{DynamicResource StudioSidebarWidth}" Grid.RowSpan="2" Margin="{DynamicResource MarginPanel}" VerticalAlignment="Top" />
   <local:ControlsPanel x:Name="Controls" Grid.Column="1" Margin="{DynamicResource MarginPanel}" />
   <local:TypeAndStatusPanel x:Name="Signals" Grid.Row="1" Grid.Column="1" Margin="{DynamicResource MarginPanel}" />
   <local:TokensPanel x:Name="Tokens" Grid.Row="2" Grid.ColumnSpan="2" Margin="{DynamicResource MarginPanel}" />
  </Grid>
 </StackPanel></ScrollViewer>
</UserControl>
