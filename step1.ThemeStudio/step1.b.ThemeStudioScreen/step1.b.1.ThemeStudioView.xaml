<UserControl x:Class="ProGlassAutomation.ThemeStudio.ThemeStudioView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:ProGlassAutomation.ThemeStudio">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Margin="{DynamicResource PaddingPage}" MaxWidth="{DynamicResource PageMaxWidth}">
   <DockPanel Margin="{DynamicResource MarginSection}">
    <Border DockPanel.Dock="Left" Style="{DynamicResource AccentPlate}" Margin="{DynamicResource MarginInline}">
     <TextBlock Text="PG / 03" Foreground="{DynamicResource AccentPrimary}" FontWeight="{DynamicResource FontWeightHeading}" />
    </Border>
    <StackPanel VerticalAlignment="Center"><TextBlock Text="PROGLASS   /   V3.0 / REFERENCE PAGE" Style="{DynamicResource Caption}" /><TextBlock Text="Theme Studio" Style="{DynamicResource PageHeading}" /></StackPanel>
   </DockPanel>
   <Border Style="{DynamicResource AccentPlate}" HorizontalAlignment="Left" Margin="{DynamicResource MarginItem}"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding SelectedTheme}" FontWeight="{DynamicResource FontWeightHeading}" Margin="{DynamicResource MarginInline}" /><TextBlock Text="{Binding AppearanceLabel}" /><TextBlock Text=" / Live reference" Style="{DynamicResource Caption}" /></StackPanel></Border>
   <WrapPanel Margin="{DynamicResource MarginSection}">
    <StackPanel Margin="{DynamicResource MarginInline}"><Label Content="Installed theme" Target="{Binding ElementName=ThemePicker}" Foreground="{DynamicResource TextSecondary}" /><ComboBox x:Name="ThemePicker" ItemsSource="{Binding InstalledThemes}" SelectedItem="{Binding SelectedTheme}" AutomationProperties.Name="Installed theme" MinWidth="{DynamicResource ControlMinWidth}" /></StackPanel>
    <StackPanel><TextBlock Text="Appearance" Style="{DynamicResource Caption}" /><WrapPanel><RadioButton Content="_Light" GroupName="Appearance" IsChecked="{Binding IsLight}" AutomationProperties.Name="Light appearance" /><RadioButton Content="_Dark" GroupName="Appearance" IsChecked="{Binding IsDark}" AutomationProperties.Name="Dark appearance" /></WrapPanel></StackPanel>
   </WrapPanel>
   <TextBlock Text="A modular foundation. One system, every surface." Style="{DynamicResource SectionHeading}" />
   <TextBlock Text="The ProGlass V3.0 design system: live components, interaction states and semantic resources. Nothing here writes business data." Foreground="{DynamicResource TextSecondary}" Margin="{DynamicResource MarginSection}" />
   <Grid x:Name="Modules" SizeChanged="Modules_SizeChanged">
    <Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <local:OverviewPanel x:Name="Overview" Margin="{DynamicResource MarginPanel}" />
    <local:AppearancePanel x:Name="Appearance" Grid.Column="1" Margin="{DynamicResource MarginPanel}" />
    <local:MetricsPanel x:Name="Metrics" Grid.Row="1" Grid.ColumnSpan="2" Margin="{DynamicResource MarginPanel}" />
    <local:ControlsPanel x:Name="Controls" Grid.Row="2" Margin="{DynamicResource MarginPanel}" />
    <local:TypeAndStatusPanel x:Name="TypeAndStatus" Grid.Row="2" Grid.Column="1" Margin="{DynamicResource MarginPanel}" />
    <local:WorklistPanel x:Name="Worklist" Grid.Row="3" Grid.ColumnSpan="2" Margin="{DynamicResource MarginPanel}" />
    <local:SurfacesPanel x:Name="Surfaces" Grid.Row="4" Grid.ColumnSpan="2" Margin="{DynamicResource MarginPanel}" />
    <local:TokensPanel x:Name="Tokens" Grid.Row="5" Grid.ColumnSpan="2" Margin="{DynamicResource MarginPanel}" />
   </Grid>
   <TextBlock Text="Bento Grid / Modular · Native WPF · Shared resources, never a separate preview palette" Style="{DynamicResource Caption}" />
  </StackPanel>
 </ScrollViewer>
</UserControl>
