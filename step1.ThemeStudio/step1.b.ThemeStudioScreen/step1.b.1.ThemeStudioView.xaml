<UserControl x:Class="ProGlassAutomation.ThemeStudio.ThemeStudioView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:ProGlassAutomation.ThemeStudio">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Margin="{DynamicResource PaddingPage}">
   <WrapPanel Margin="{DynamicResource MarginSection}">
    <DockPanel Margin="{DynamicResource MarginInline}">
     <Border DockPanel.Dock="Left" Style="{DynamicResource AccentPlate}" Margin="{DynamicResource MarginInline}"><TextBlock Text="PG / 03" Foreground="{DynamicResource AccentPrimary}" FontWeight="{DynamicResource FontWeightHeading}" /></Border>
     <StackPanel><TextBlock Text="PROGLASS V3.0 / REFERENCE PAGE" Style="{DynamicResource Caption}" /><TextBlock Text="Theme Studio" Style="{DynamicResource PageHeading}" /></StackPanel>
    </DockPanel>
    <StackPanel Margin="{DynamicResource MarginInline}"><Label Content="Installed theme" Target="{Binding ElementName=ThemePicker}" Foreground="{DynamicResource TextSecondary}" /><ComboBox x:Name="ThemePicker" ItemsSource="{Binding InstalledThemes}" SelectedItem="{Binding SelectedTheme}" AutomationProperties.Name="Installed theme" MinWidth="{DynamicResource ControlMinWidth}" /></StackPanel>
    <StackPanel Margin="{DynamicResource MarginInline}"><TextBlock Text="Appearance" Style="{DynamicResource Caption}" /><WrapPanel><RadioButton Content="_Light" GroupName="Appearance" IsChecked="{Binding IsLight}" AutomationProperties.Name="Light appearance" /><RadioButton Content="_Dark" GroupName="Appearance" IsChecked="{Binding IsDark}" AutomationProperties.Name="Dark appearance" /></WrapPanel></StackPanel>
    <Border Style="{DynamicResource AccentPlate}" VerticalAlignment="Center" Margin="{DynamicResource MarginInline}"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding SelectedTheme}" FontWeight="{DynamicResource FontWeightHeading}" Margin="{DynamicResource MarginInline}" /><TextBlock Text="{Binding AppearanceLabel}" /></StackPanel></Border>
   </WrapPanel>
   <TextBlock Text="The ProGlass V3.0 design system / live components, reference patterns and semantic resources. Preview data only." Foreground="{DynamicResource TextSecondary}" Margin="{DynamicResource MarginSection}" />
   <Grid x:Name="Modules" SizeChanged="Modules_SizeChanged">
    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition Width="0" /></Grid.ColumnDefinitions>
    <StackPanel x:Name="LaneOne">
     <local:OverviewPanel x:Name="Overview" Margin="{DynamicResource MarginPanel}" />
     <local:MetricsPanel x:Name="Metrics" Margin="{DynamicResource MarginPanel}" />
     <local:ControlsPanel x:Name="Controls" Margin="{DynamicResource MarginPanel}" />
     <local:WorklistPanel x:Name="Worklist" Margin="{DynamicResource MarginPanel}" />
     <local:AppearancePanel x:Name="Appearance" Margin="{DynamicResource MarginPanel}" />
     <local:TypeAndStatusPanel x:Name="TypeAndStatus" Margin="{DynamicResource MarginPanel}" />
     <local:SurfacesPanel x:Name="Surfaces" Margin="{DynamicResource MarginPanel}" />
     <local:TokensPanel x:Name="Tokens" Margin="{DynamicResource MarginPanel}" />
    </StackPanel>
    <StackPanel x:Name="LaneTwo" Grid.Column="1" />
    <StackPanel x:Name="LaneThree" Grid.Column="2" />
   </Grid>
   <TextBlock Text="Bento Grid / Modular · Native WPF · Shared resources, never a separate preview palette" Style="{DynamicResource Caption}" />
  </StackPanel>
 </ScrollViewer>
</UserControl>
