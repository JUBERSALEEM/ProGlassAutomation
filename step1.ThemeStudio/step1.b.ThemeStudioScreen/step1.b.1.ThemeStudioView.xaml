<UserControl x:Class="ProGlassAutomation.ThemeStudio.ThemeStudioView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:ProGlassAutomation.ThemeStudio">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Margin="{DynamicResource PaddingPage}">
   <DockPanel Margin="{DynamicResource MarginSection}">
    <Border DockPanel.Dock="Left" Style="{DynamicResource AccentPlate}" Margin="{DynamicResource MarginInline}">
     <TextBlock Text="PG / 03" Foreground="{DynamicResource AccentPrimary}" FontWeight="{DynamicResource FontWeightHeading}" />
    </Border>
    <StackPanel VerticalAlignment="Center"><TextBlock Text="PROGLASS   /   DESIGN LABORATORY" Style="{DynamicResource Caption}" /><TextBlock Text="Theme Studio" Style="{DynamicResource PageHeading}" /></StackPanel>
   </DockPanel>
   <TextBlock Text="A modular foundation. One system, every surface." Style="{DynamicResource SectionHeading}" />
   <TextBlock Text="Explore Bento’s live components, interaction states and semantic resources. Nothing here writes business data." Foreground="{DynamicResource TextSecondary}" Margin="{DynamicResource MarginSection}" />
   <Grid x:Name="Modules" SizeChanged="Modules_SizeChanged">
    <Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <local:OverviewPanel x:Name="Overview" Margin="{DynamicResource MarginPanel}" />
    <local:AppearancePanel x:Name="Appearance" Grid.Column="1" Margin="{DynamicResource MarginPanel}" />
    <local:ControlsPanel x:Name="Controls" Grid.Row="1" Margin="{DynamicResource MarginPanel}" />
    <local:TypeAndStatusPanel x:Name="TypeAndStatus" Grid.Row="1" Grid.Column="1" Margin="{DynamicResource MarginPanel}" />
    <local:SurfacesPanel x:Name="Surfaces" Grid.Row="2" Grid.ColumnSpan="2" Margin="{DynamicResource MarginPanel}" />
    <local:TokensPanel x:Name="Tokens" Grid.Row="3" Grid.ColumnSpan="2" Margin="{DynamicResource MarginPanel}" />
   </Grid>
   <TextBlock Text="Bento Grid / Modular · Native WPF · Shared resources, never a separate preview palette" Style="{DynamicResource Caption}" />
  </StackPanel>
 </ScrollViewer>
</UserControl>
