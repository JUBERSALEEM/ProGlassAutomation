<UserControl x:Class="ProGlassAutomation.ThemeStudio.ThemeStudioView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ProGlassAutomation.ThemeStudio" xmlns:bento="clr-namespace:ProGlassAutomation.ThemeBento">
 <Grid>
  <Grid.ColumnDefinitions>
   <ColumnDefinition Width="*"/>
   <ColumnDefinition Width="Auto"/>
  </Grid.ColumnDefinitions>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" PanningMode="VerticalOnly">
   <bento:BentoGrid x:Name="Modules" Columns="3" FillAvailable="False"
                    RowHeight="{DynamicResource BentoRowHeight}" Gutter="{DynamicResource BentoGutter}" CompactWidth="{DynamicResource BentoCompactWidth}">
    <local:AnalyticsOverview x:Name="Preview" Compact="True" bento:BentoGrid.Column="0" bento:BentoGrid.Row="0" bento:BentoGrid.ColumnSpan="3" bento:BentoGrid.RowSpan="3"/>
    <local:ChartGallery x:Name="Gallery" bento:BentoGrid.Column="0" bento:BentoGrid.Row="3" bento:BentoGrid.ColumnSpan="3" bento:BentoGrid.RowSpan="2"/>
    <local:TypeAndStatusPanel x:Name="Signals" bento:BentoGrid.Column="0" bento:BentoGrid.Row="5" bento:BentoGrid.ColumnSpan="1" bento:BentoGrid.RowSpan="3"/>
    <local:ControlsPanel x:Name="Controls" bento:BentoGrid.Column="1" bento:BentoGrid.Row="5" bento:BentoGrid.ColumnSpan="1" bento:BentoGrid.RowSpan="3"/>
    <local:TokensPanel x:Name="Tokens" bento:BentoGrid.Column="2" bento:BentoGrid.Row="5" bento:BentoGrid.ColumnSpan="1" bento:BentoGrid.RowSpan="3"/>
   </bento:BentoGrid>
  </ScrollViewer>
  <local:CustomizationPanel x:Name="Settings" Grid.Column="1" Width="{DynamicResource StudioSidebarWidth}" VerticalAlignment="Stretch"/>
 </Grid>
</UserControl>
