<UserControl x:Class="ProGlassAutomation.ThemeStudio.ControlsPanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Border Style="{DynamicResource Card}"><StackPanel>
  <TextBlock Text="03 / INTERACTION" Style="{DynamicResource Caption}" Margin="{DynamicResource MarginItem}" />
  <TextBlock Text="Controls that feel consistent." Style="{DynamicResource SectionHeading}" />
  <Label Content="Preview name (minimum 3 characters)" Target="{Binding ElementName=PreviewName}" Foreground="{DynamicResource TextSecondary}" />
  <TextBox x:Name="PreviewName" Text="{Binding SampleName, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" AutomationProperties.Name="Preview name" Margin="{DynamicResource MarginItem}" />
  <TextBlock Text="{Binding NameError}" Foreground="{DynamicResource StatusError}" Margin="{DynamicResource MarginItem}" />
  <WrapPanel Margin="{DynamicResource MarginItem}">
   <Button Content="_Apply preview" Command="{Binding ApplyPreview}" Style="{DynamicResource PrimaryButton}" Margin="{DynamicResource MarginInline}" />
   <Button Content="_Reset" Command="{Binding ResetPreview}" Margin="{DynamicResource MarginInline}" />
   <Button Content="_Clear preview" Style="{DynamicResource DestructiveButton}" Command="{Binding ClearPreview}" ToolTip="Clears only the local preview name, not saved data." Margin="{DynamicResource MarginInline}" />
   <Button Content="_Help" Style="{DynamicResource SubtleButton}" Command="{Binding ShowHelp}" Margin="{DynamicResource MarginInline}" />
   <Button Content="Unavailable" IsEnabled="False" Margin="{DynamicResource MarginInline}" />
  </WrapPanel>
  <CheckBox Content="Show helper labels" IsChecked="{Binding ShowHelpers}" AutomationProperties.Name="Show helper labels" />
  <TextBlock Text="Tab to explore focus. Space activates toggles; Alt+Down opens selections. Right-click the action below for a themed menu." Margin="{DynamicResource MarginItem}">
   <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Caption}"><Style.Triggers><DataTrigger Binding="{Binding ShowHelpers}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
  </TextBlock>
  <Border Style="{DynamicResource Plate}" Margin="{DynamicResource MarginItem}"><TextBlock Text="{Binding Feedback}" AutomationProperties.LiveSetting="Polite" /></Border>
  <Button Content="Advance progress / restart at 100%" Command="{Binding AdvanceProgress}" HorizontalAlignment="Left" Margin="{DynamicResource MarginItem}">
   <Button.ContextMenu><ContextMenu><MenuItem Header="Reset preview" Command="{Binding ResetPreview}" /><MenuItem Header="Open preview window" Command="{Binding OpenDialog}" /></ContextMenu></Button.ContextMenu>
  </Button>
  <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" AutomationProperties.Name="Demonstration progress" />
  <TextBlock Text="{Binding Progress, StringFormat='Demonstration progress: {0}%'}" Style="{DynamicResource Caption}" />
 </StackPanel></Border>
</UserControl>
