<UserControl x:Class="ProGlassAutomation.ThemeStudio.AnalyticsOverview" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ProGlassAutomation.ThemeStudio" xmlns:analytics="clr-namespace:ProGlassAutomation.Analytics">
 <UserControl.Resources><local:AnalyticsSamples x:Key="Samples" /></UserControl.Resources>
 <StackPanel DataContext="{StaticResource Samples}" Background="{DynamicResource TransparentBrush}">
  <UniformGrid Columns="4" Margin="{DynamicResource MarginSection}">
   <Border Background="{DynamicResource SurfacePrimary}" CornerRadius="{DynamicResource CardCornerRadius}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="{DynamicResource BorderThicknessControl}" Padding="{DynamicResource PaddingCard}" Margin="{DynamicResource MarginItem}"><StackPanel><TextBlock Text="Monthly revenue" Foreground="{DynamicResource TextPrimary}" FontWeight="ExtraBold" FontSize="{DynamicResource FontSizeCaption}"/><TextBlock Text="AED 284k" Foreground="{DynamicResource TextPrimary}" FontWeight="ExtraBold" FontSize="{DynamicResource FontSizeTitle}"/><TextBlock Text="↑ 6.4% vs September · Demo" Foreground="{DynamicResource StatusSuccess}" FontWeight="Bold" Style="{DynamicResource Caption}"/></StackPanel></Border>
   <Border Background="{DynamicResource SurfacePrimary}" CornerRadius="{DynamicResource CardCornerRadius}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="{DynamicResource BorderThicknessControl}" Padding="{DynamicResource PaddingCard}" Margin="{DynamicResource MarginItem}"><StackPanel><TextBlock Text="Orders" Foreground="{DynamicResource TextPrimary}" FontWeight="ExtraBold" FontSize="{DynamicResource FontSizeCaption}"/><TextBlock Text="128" Foreground="{DynamicResource TextPrimary}" FontWeight="ExtraBold" FontSize="{DynamicResource FontSizeTitle}"/><TextBlock Text="120 completed · Demo" Foreground="{DynamicResource TextSecondary}" Style="{DynamicResource Caption}"/></StackPanel></Border>
   <Border Background="{DynamicResource SurfacePrimary}" CornerRadius="{DynamicResource CardCornerRadius}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="{DynamicResource BorderThicknessControl}" Padding="{DynamicResource PaddingCard}" Margin="{DynamicResource MarginItem}"><StackPanel><TextBlock Text="Conversion" Foreground="{DynamicResource TextPrimary}" FontWeight="ExtraBold" FontSize="{DynamicResource FontSizeCaption}"/><TextBlock Text="72%" Foreground="{DynamicResource TextPrimary}" FontWeight="ExtraBold" FontSize="{DynamicResource FontSizeTitle}"/><TextBlock Text="↑ 3 points · Demo" Foreground="{DynamicResource StatusSuccess}" FontWeight="Bold" Style="{DynamicResource Caption}"/></StackPanel></Border>
   <Border Background="{DynamicResource SurfacePrimary}" CornerRadius="{DynamicResource CardCornerRadius}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="{DynamicResource BorderThicknessControl}" Padding="{DynamicResource PaddingCard}" Margin="{DynamicResource MarginItem}"><StackPanel><TextBlock Text="Available slots" Foreground="{DynamicResource TextPrimary}" FontWeight="ExtraBold" FontSize="{DynamicResource FontSizeCaption}"/><TextBlock Text="5 / 60" Foreground="{DynamicResource TextPrimary}" FontWeight="ExtraBold" FontSize="{DynamicResource FontSizeTitle}"/><TextBlock Text="October capacity · Demo" Foreground="{DynamicResource TextSecondary}" Style="{DynamicResource Caption}"/></StackPanel></Border>
  </UniformGrid>
  <Grid x:Name="AnalyticsGrid" SizeChanged="AnalyticsGrid_SizeChanged" Margin="{DynamicResource MarginSection}">
   <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Border x:Name="RevenueCard" Background="{DynamicResource SurfacePrimary}" CornerRadius="{DynamicResource CardCornerRadius}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="{DynamicResource BorderThicknessControl}" Padding="{DynamicResource PaddingCard}" Margin="{DynamicResource MarginItem}">
    <StackPanel><DockPanel Margin="{DynamicResource MarginItem}"><Border Style="{DynamicResource StatusBadge}" Tag="Success" DockPanel.Dock="Right"><TextBlock Text="Above target" Style="{DynamicResource StatusText}" Tag="Success" FontWeight="Bold"/></Border><StackPanel><TextBlock Text="Revenue performance" Foreground="{DynamicResource TextPrimary}" FontWeight="ExtraBold" FontSize="{DynamicResource FontSizeSection}"/><TextBlock Text="MAY–OCTOBER / DEMO SNAPSHOT" Foreground="{DynamicResource TextMuted}" Style="{DynamicResource Caption}" FontWeight="Bold"/></StackPanel></DockPanel><analytics:BentoChart Data="{Binding Revenue}" PlotHeight="220"/></StackPanel>
   </Border>
   <Border x:Name="MixCard" Grid.Column="1" Background="{DynamicResource SurfacePrimary}" CornerRadius="{DynamicResource CardCornerRadius}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="{DynamicResource BorderThicknessControl}" Padding="{DynamicResource PaddingCard}" Margin="{DynamicResource MarginItem}"><StackPanel><TextBlock Text="Order composition" Foreground="{DynamicResource TextPrimary}" FontWeight="ExtraBold" FontSize="{DynamicResource FontSizeSection}" Margin="{DynamicResource MarginItem}"/><analytics:BentoChart Data="{Binding Mix}" PlotHeight="160"/></StackPanel></Border>
   <Border x:Name="TrendCard" Grid.Row="1" Background="{DynamicResource SurfacePrimary}" CornerRadius="{DynamicResource CardCornerRadius}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="{DynamicResource BorderThicknessControl}" Padding="{DynamicResource PaddingCard}" Margin="{DynamicResource MarginItem}"><StackPanel><TextBlock Text="Order momentum" Foreground="{DynamicResource TextPrimary}" FontWeight="ExtraBold" FontSize="{DynamicResource FontSizeSection}" Margin="{DynamicResource MarginItem}"/><analytics:BentoChart Data="{Binding Trend}" PlotHeight="160"/></StackPanel></Border>
   <Border x:Name="TargetCard" Grid.Row="1" Grid.Column="1" Background="{DynamicResource SurfacePrimary}" CornerRadius="{DynamicResource CardCornerRadius}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="{DynamicResource BorderThicknessControl}" Padding="{DynamicResource PaddingCard}" Margin="{DynamicResource MarginItem}"><StackPanel><TextBlock Text="Monthly target" Foreground="{DynamicResource TextPrimary}" FontWeight="ExtraBold" FontSize="{DynamicResource FontSizeSection}"/><TextBlock Text="98% on-time delivery" Foreground="{DynamicResource TextPrimary}" FontSize="{DynamicResource FontSizeTitle}" FontWeight="ExtraBold"/><TextBlock Text="Target 95% · Demo snapshot" Foreground="{DynamicResource TextMuted}" Style="{DynamicResource Caption}" FontWeight="Bold"/><ProgressBar Value="98" Maximum="100" AutomationProperties.Name="Demo on-time delivery 98 percent, target 95 percent" Margin="{DynamicResource MarginSection}" Foreground="{DynamicResource AccentPrimary}"/><Border Background="{DynamicResource SurfaceSecondary}" CornerRadius="{DynamicResource ControlCornerRadius}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="{DynamicResource BorderThicknessControl}" Padding="{DynamicResource PaddingCard}" Margin="{DynamicResource MarginItem}"><StackPanel><TextBlock Text="Conversion momentum" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" FontSize="{DynamicResource FontSizeCaption}"/><analytics:BentoChart Data="{Binding Spark}" PlotHeight="90"/></StackPanel></Border></StackPanel></Border>
   <Border x:Name="TableCard" Grid.Row="2" Grid.ColumnSpan="2" Background="{DynamicResource SurfacePrimary}" CornerRadius="{DynamicResource CardCornerRadius}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="{DynamicResource BorderThicknessControl}" Padding="{DynamicResource PaddingCard}" Margin="{DynamicResource MarginItem}"><StackPanel><TextBlock Text="Recent work / compact table" Foreground="{DynamicResource TextPrimary}" FontWeight="ExtraBold" FontSize="{DynamicResource FontSizeSection}"/><TextBlock Text="Four deterministic examples. Sort columns and select a row; switching appearance retains selection." Foreground="{DynamicResource TextSecondary}" Style="{DynamicResource Caption}" Margin="{DynamicResource MarginItem}"/><DataGrid x:Name="RecentWork" ItemsSource="{Binding Rows}" Height="190" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="{DynamicResource BorderThicknessControl}" RowBackground="{DynamicResource SurfacePrimary}" AlternatingRowBackground="{DynamicResource SurfaceSecondary}" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource BorderSubtle}" AutomationProperties.Name="Recent work, demo records" Margin="{DynamicResource MarginItem}"><DataGrid.Columns><DataGridTextColumn Header="Reference" Binding="{Binding Reference}" Width="*"/><DataGridTextColumn Header="Account" Binding="{Binding Account}" Width="2*"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/><DataGridTextColumn Header="Amount" Binding="{Binding Amount}" Width="*"/><DataGridTextColumn Header="Due" Binding="{Binding Due}" Width="*"/></DataGrid.Columns></DataGrid></StackPanel></Border>
   <Border x:Name="ActivityCard" Grid.Row="3" Background="{DynamicResource SurfacePrimary}" CornerRadius="{DynamicResource CardCornerRadius}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="{DynamicResource BorderThicknessControl}" Padding="{DynamicResource PaddingCard}" Margin="{DynamicResource MarginItem}"><StackPanel><TextBlock Text="Activity snapshot" Foreground="{DynamicResource TextPrimary}" FontWeight="ExtraBold" FontSize="{DynamicResource FontSizeSection}"/><TextBlock Text="09:40  •  PG-1042 marked ready" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/><TextBlock Text="09:15  •  PG-1041 entered review" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/><TextBlock Text="08:50  •  October capacity updated" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/><TextBlock Text="Illustrative events only — not a live activity feed." Foreground="{DynamicResource TextMuted}" Style="{DynamicResource Caption}"/></StackPanel></Border>
   <Border x:Name="StatusCard" Grid.Row="3" Grid.Column="1" Background="{DynamicResource SurfacePrimary}" CornerRadius="{DynamicResource CardCornerRadius}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="{DynamicResource BorderThicknessControl}" Padding="{DynamicResource PaddingCard}" Margin="{DynamicResource MarginItem}"><StackPanel><TextBlock Text="Attention queue" Foreground="{DynamicResource TextPrimary}" FontWeight="ExtraBold" FontSize="{DynamicResource FontSizeSection}"/><TextBlock Text="1 on hold / 1 in review" Foreground="{DynamicResource TextPrimary}" FontSize="{DynamicResource FontSizeTitle}" FontWeight="ExtraBold"/><TextBlock Text="Review the worklist below. All values on this page are demonstration data." Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="{DynamicResource MarginItem}"/></StackPanel></Border>
  </Grid>
 </StackPanel>
</UserControl>