<UserControl x:Class="ProGlassAutomation.ThemeStudio.AnalyticsOverview" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ProGlassAutomation.ThemeStudio" xmlns:analytics="clr-namespace:ProGlassAutomation.Analytics" xmlns:bento="clr-namespace:ProGlassAutomation.ThemeBento">
 <UserControl.Resources><local:AnalyticsSamples x:Key="Samples" /></UserControl.Resources>
 <bento:BentoGrid x:Name="AnalyticsGrid" DataContext="{StaticResource Samples}" Columns="4" FillAvailable="False"
                  RowHeight="{DynamicResource BentoRowHeight}" Gutter="{DynamicResource BentoGutter}" CompactWidth="{DynamicResource BentoCompactWidth}">
  <analytics:BentoKpi x:Name="KpiRevenue" Label="Monthly revenue" Value="AED 284k" Detail="↑ 6.4% vs September · Demo" bento:BentoGrid.Column="0" bento:BentoGrid.Row="0" bento:BentoGrid.ColumnSpan="2"/>
  <analytics:BentoKpi x:Name="KpiOrders" Tag="Positive" Label="Orders" Value="128" Detail="120 completed · Demo" bento:BentoGrid.Column="2" bento:BentoGrid.Row="0"/>
  <analytics:BentoKpi x:Name="KpiConversion" Tag="Feature" Label="Conversion" Value="72%" Detail="↑ 3 points · Demo" bento:BentoGrid.Column="3" bento:BentoGrid.Row="0"/>
  <ContentControl x:Name="RevenueCard" Style="{DynamicResource ChartCard}" bento:BentoGrid.Column="0" bento:BentoGrid.Row="1" bento:BentoGrid.ColumnSpan="2" bento:BentoGrid.RowSpan="3">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <DockPanel>
     <Border Style="{DynamicResource StatusBadge}" Tag="Success" DockPanel.Dock="Right"><TextBlock Text="Above target" Style="{DynamicResource StatusText}" Tag="Success" /></Border>
     <StackPanel><TextBlock Text="Revenue performance" Style="{DynamicResource SectionHeading}" /><TextBlock Text="MAY–OCTOBER / DEMO SNAPSHOT" Style="{DynamicResource Caption}" /></StackPanel>
    </DockPanel>
    <analytics:BentoChart Grid.Row="1" Data="{Binding Revenue}" />
   </Grid>
  </ContentControl>
  <ContentControl x:Name="MixCard" Style="{DynamicResource FeaturePlate}" bento:BentoGrid.Column="2" bento:BentoGrid.Row="1" bento:BentoGrid.ColumnSpan="1" bento:BentoGrid.RowSpan="3">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBlock Text="Order composition" Style="{DynamicResource SectionHeading}" />
    <analytics:BentoChart Grid.Row="1" Data="{Binding Mix}" />
   </Grid>
  </ContentControl>
  <ContentControl x:Name="TargetCard" Style="{DynamicResource PositivePlate}" bento:BentoGrid.Column="3" bento:BentoGrid.Row="1" bento:BentoGrid.ColumnSpan="1" bento:BentoGrid.RowSpan="3">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel>
     <TextBlock Text="Monthly target" Style="{DynamicResource SectionHeading}" />
     <TextBlock Text="98% on-time delivery" FontSize="{DynamicResource FontSizeTitle}" FontWeight="{DynamicResource FontWeightHeading}" />
     <TextBlock Text="Target 95% · Demo snapshot" Style="{DynamicResource Caption}" />
     <TextBlock Text="Conversion momentum" Style="{DynamicResource SectionHeading}" />
    </StackPanel>
    <analytics:BentoChart Grid.Row="1" Data="{Binding Spark}" PlotHeight="90" />
   </Grid>
  </ContentControl>
  <ContentControl x:Name="TrendCard" Style="{DynamicResource ChartCard}" bento:BentoGrid.Column="0" bento:BentoGrid.Row="4" bento:BentoGrid.ColumnSpan="2" bento:BentoGrid.RowSpan="3">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBlock Text="Order momentum" Style="{DynamicResource SectionHeading}" />
    <analytics:BentoChart Grid.Row="1" Data="{Binding Trend}" />
   </Grid>
  </ContentControl>
  <ContentControl x:Name="ActivityCard" Style="{DynamicResource InformationPlate}" bento:BentoGrid.Column="2" bento:BentoGrid.Row="4" bento:BentoGrid.ColumnSpan="1" bento:BentoGrid.RowSpan="3">
   <StackPanel>
    <TextBlock Text="Activity snapshot" Style="{DynamicResource SectionHeading}" />
    <TextBlock Text="09:40  •  PG-1042 marked ready" />
    <TextBlock Text="09:15  •  PG-1041 entered review" />
    <TextBlock Text="08:50  •  October capacity updated" />
    <TextBlock Text="Illustrative events only — not a live activity feed." Style="{DynamicResource Caption}" />
   </StackPanel>
  </ContentControl>
  <ContentControl x:Name="StatusCard" Style="{DynamicResource AttentionPlate}" bento:BentoGrid.Column="3" bento:BentoGrid.Row="4" bento:BentoGrid.ColumnSpan="1" bento:BentoGrid.RowSpan="3">
   <StackPanel>
    <TextBlock Text="Attention queue" Style="{DynamicResource SectionHeading}" />
    <TextBlock Text="1 on hold / 1 in review" FontSize="{DynamicResource FontSizeTitle}" />
    <TextBlock Text="5 / 60 slots left · Demo snapshot." TextWrapping="Wrap" />
   </StackPanel>
  </ContentControl>
  <ContentControl x:Name="TableCard" Style="{DynamicResource ChartCard}" bento:BentoGrid.Column="0" bento:BentoGrid.Row="7" bento:BentoGrid.ColumnSpan="4" bento:BentoGrid.RowSpan="3">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel>
     <TextBlock Text="Recent work / compact table" Style="{DynamicResource SectionHeading}" />
     <TextBlock Text="Four deterministic examples. Sort columns and select a row; switching appearance retains selection." Style="{DynamicResource Caption}" />
    </StackPanel>
    <DataGrid Grid.Row="1" x:Name="RecentWork" ItemsSource="{Binding Rows}" EnableRowVirtualization="False" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Recent work, demo records">
     <DataGrid.Columns>
      <DataGridTextColumn Header="Reference" Binding="{Binding Reference}" Width="*" />
      <DataGridTextColumn Header="Account" Binding="{Binding Account}" Width="2*" />
      <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*" />
      <DataGridTextColumn Header="Amount" Binding="{Binding Amount}" Width="*" />
      <DataGridTextColumn Header="Due" Binding="{Binding Due}" Width="*" />
     </DataGrid.Columns>
    </DataGrid>
   </Grid>
  </ContentControl>
 </bento:BentoGrid>
</UserControl>
