<UserControl x:Class="ProGlassAutomation.ThemeStudio.AnalyticsOverview" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ProGlassAutomation.ThemeStudio" xmlns:analytics="clr-namespace:ProGlassAutomation.Analytics" xmlns:bento="clr-namespace:ProGlassAutomation.ThemeBento">
 <UserControl.Resources><local:AnalyticsSamples x:Key="Samples" /></UserControl.Resources>
 <bento:BentoGrid x:Name="AnalyticsGrid" DataContext="{StaticResource Samples}" Columns="4" FillAvailable="False"
                  RowHeight="{DynamicResource BentoRowHeight}" Gutter="{DynamicResource BentoGutter}" CompactWidth="{DynamicResource BentoCompactWidth}">
  <analytics:BentoKpi x:Name="KpiRevenue" Label="Monthly revenue" Value="AED 284k" Detail="↑ 6.4% vs September · Demo" bento:BentoGrid.Column="0" bento:BentoGrid.Row="0"/>
  <analytics:BentoKpi x:Name="KpiOrders" Tag="Positive" Label="Orders" Value="128" Detail="120 completed · Demo" bento:BentoGrid.Column="1" bento:BentoGrid.Row="0"/>
  <analytics:BentoKpi x:Name="KpiConversion" Tag="Feature" Label="Conversion" Value="72%" Detail="↑ 3 points · Demo" bento:BentoGrid.Column="2" bento:BentoGrid.Row="0"/>
  <ContentControl x:Name="RevenueCard" Style="{DynamicResource ChartCard}" bento:BentoGrid.Column="0" bento:BentoGrid.Row="1">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <DockPanel>
     <Border Style="{DynamicResource StatusBadge}" Tag="Success" DockPanel.Dock="Right"><TextBlock Text="Above target" Style="{DynamicResource StatusText}" Tag="Success" /></Border>
     <TextBlock Text="Revenue" Style="{DynamicResource SectionHeading}" />
    </DockPanel>
    <analytics:BentoChart Grid.Row="1" Data="{Binding Revenue}" />
   </Grid>
  </ContentControl>
  <ContentControl x:Name="MixCard" Style="{DynamicResource FeaturePlate}" bento:BentoGrid.Column="1" bento:BentoGrid.Row="1">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBlock Text="Order mix" Style="{DynamicResource SectionHeading}" />
    <analytics:BentoChart Grid.Row="1" Data="{Binding Mix}" />
   </Grid>
  </ContentControl>
  <ContentControl x:Name="TargetCard" Style="{DynamicResource PositivePlate}" bento:BentoGrid.Column="2" bento:BentoGrid.Row="1">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel>
     <TextBlock Text="98% on-time" FontSize="{DynamicResource FontSizeTitle}" FontWeight="{DynamicResource FontWeightHeading}" />
     <TextBlock Text="Target 95% · momentum" Style="{DynamicResource Caption}" />
    </StackPanel>
    <analytics:BentoChart Grid.Row="1" Data="{Binding Spark}" />
   </Grid>
  </ContentControl>
  <ContentControl x:Name="TrendCard" Style="{DynamicResource ChartCard}" bento:BentoGrid.Column="3" bento:BentoGrid.Row="1">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBlock Text="Momentum" Style="{DynamicResource SectionHeading}" />
    <analytics:BentoChart Grid.Row="1" Data="{Binding Trend}" />
   </Grid>
  </ContentControl>
  <ContentControl x:Name="ActivityCard" Style="{DynamicResource InformationPlate}" bento:BentoGrid.Column="0" bento:BentoGrid.Row="2">
   <StackPanel>
    <TextBlock Text="Activity" Style="{DynamicResource SectionHeading}" />
    <TextBlock Text="09:40  PG-1042 ready" FontSize="{DynamicResource FontSizeCaption}" />
    <TextBlock Text="09:15  PG-1041 review" FontSize="{DynamicResource FontSizeCaption}" />
    <TextBlock Text="08:50  Capacity update" FontSize="{DynamicResource FontSizeCaption}" />
   </StackPanel>
  </ContentControl>
  <ContentControl x:Name="StatusCard" Style="{DynamicResource AttentionPlate}" bento:BentoGrid.Column="3" bento:BentoGrid.Row="0">
   <StackPanel>
    <TextBlock Text="Attention" Style="{DynamicResource SectionHeading}" />
    <TextBlock Text="1 hold / 1 review" FontSize="{DynamicResource FontSizeTitle}" FontWeight="{DynamicResource FontWeightHeading}" />
    <TextBlock Text="5 / 60 slots · Demo" Style="{DynamicResource Caption}" TextWrapping="Wrap" />
   </StackPanel>
  </ContentControl>
  <ContentControl x:Name="TableCard" Style="{DynamicResource ChartCard}" bento:BentoGrid.Column="1" bento:BentoGrid.Row="2" bento:BentoGrid.ColumnSpan="3" bento:BentoGrid.RowSpan="2">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel>
     <TextBlock Text="Recent work / compact table" Style="{DynamicResource SectionHeading}" />
     <TextBlock Text="Four deterministic examples. Sort columns and select a row; switching appearance retains selection." Style="{DynamicResource Caption}" />
    </StackPanel>
    <DataGrid Grid.Row="1" x:Name="RecentWork" ItemsSource="{Binding Rows}" EnableRowVirtualization="False" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Recent work, demo records">
     <DataGrid.Columns>
      <DataGridTextColumn Header="Reference" Binding="{Binding Reference}" Width="*" />
      <DataGridTextColumn Header="Account" Binding="{Binding Account}" Width="2*" />
      <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*" />
      <DataGridTextColumn Header="Amount" Binding="{Binding Amount}" Width="*" />
      <DataGridTextColumn Header="Due" Binding="{Binding Due}" Width="*" />
     </DataGrid.Columns>
    </DataGrid>
   </Grid>
  </ContentControl>
 </bento:BentoGrid>
</UserControl>
