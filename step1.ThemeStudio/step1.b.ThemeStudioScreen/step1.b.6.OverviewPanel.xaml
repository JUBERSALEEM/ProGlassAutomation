<UserControl x:Class="ProGlassAutomation.ThemeStudio.OverviewPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ProGlassAutomation.ThemeStudio">
 <Border Style="{DynamicResource HeroCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition /></Grid.ColumnDefinitions>
  <StackPanel><TextBlock Text="YOUR WORK, IN FOCUS" Foreground="{DynamicResource HeroSecondaryText}" FontSize="{DynamicResource FontSizeCaption}" /><TextBlock Text="Good work starts with a clear view." Foreground="{DynamicResource HeroForeground}" FontSize="{DynamicResource FontSizeTitle}" FontWeight="{DynamicResource FontWeightHeading}" Margin="{DynamicResource MarginItem}" /><TextBlock Text="Review priorities, keep the team aligned and move the next detail forward." Foreground="{DynamicResource HeroSecondaryText}" Margin="{DynamicResource MarginSection}" /><Button Content="Review selected item" Command="{Binding ReviewReference}" HorizontalAlignment="Left" /><TextBlock Text="Illustrative trend / not connected to business data" Foreground="{DynamicResource HeroSecondaryText}" FontSize="{DynamicResource FontSizeCaption}" /></StackPanel>
  <Viewbox Grid.Column="1" Margin="{DynamicResource PaddingPlate}" Stretch="Uniform"><Path Data="{DynamicResource ActivityTrendGeometry}" Stroke="{DynamicResource HeroAccent}" StrokeThickness="{DynamicResource StrokeWidth}" StrokeLineJoin="Round" /></Viewbox>
 </Grid></Border>
</UserControl>
