<UserControl x:Class="ProGlassAutomation.ThemeStudio.OverviewPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ProGlassAutomation.ThemeStudio">
 <ContentControl Style="{DynamicResource HeroCard}"><Grid>
  <StackPanel>
   <TextBlock Text="YOUR WORK, IN FOCUS" Foreground="{DynamicResource HeroSecondaryText}" FontSize="{DynamicResource FontSizeCaption}" />
   <TextBlock Text="Good work starts with a clear view." Foreground="{DynamicResource HeroForeground}" FontSize="{DynamicResource FontSizeTitle}" FontWeight="{DynamicResource FontWeightHeading}" Margin="{DynamicResource MarginItem}" />
   <Button Content="Review selected item" Command="{Binding ReviewReference}" HorizontalAlignment="Left" />
   <TextBlock Text="October 2026 · demo, not live ERP" Foreground="{DynamicResource HeroSecondaryText}" FontSize="{DynamicResource FontSizeCaption}" Margin="{DynamicResource MarginItem}" />
  </StackPanel>
 </Grid></ContentControl>
</UserControl>
