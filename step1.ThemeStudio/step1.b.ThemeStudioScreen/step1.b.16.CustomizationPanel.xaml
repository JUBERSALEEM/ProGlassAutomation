<UserControl x:Class="ProGlassAutomation.ThemeStudio.CustomizationPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer VerticalScrollBarVisibility="Auto">
  <StackPanel>
   <ContentControl Style="{DynamicResource Card}" Margin="{DynamicResource MarginSection}">
    <StackPanel>
     <DockPanel Margin="{DynamicResource MarginItem}"><TextBlock Text="Design settings" Style="{DynamicResource SectionHeading}"/><Border Tag="Success" Style="{DynamicResource StatusBadge}" HorizontalAlignment="Right"><TextBlock Text="LIVE" Foreground="{DynamicResource StatusSuccess}" Style="{DynamicResource Caption}"/></Border></DockPanel>
     <TextBlock Text="Every control updates the live preview. Use Save to keep it next launch — discard reverts to last saved." Style="{DynamicResource Caption}"/>
    </StackPanel>
   </ContentControl>
   <ContentControl Style="{DynamicResource Card}" Margin="{DynamicResource MarginSection}">
    <StackPanel>
     <Label Content="Theme" Target="{Binding ElementName=ThemePicker}" Foreground="{DynamicResource TextSecondary}"/><ComboBox x:Name="ThemePicker" ItemsSource="{Binding InstalledThemes}" SelectedItem="{Binding SelectedTheme}" AutomationProperties.Name="Installed theme" Margin="{DynamicResource MarginItem}"/>
     <TextBlock Text="Appearance" Style="{DynamicResource Caption}"/><WrapPanel Margin="{DynamicResource MarginItem}"><RadioButton Content="_Light" GroupName="Appearance" IsChecked="{Binding IsLight}" AutomationProperties.Name="Light appearance"/><RadioButton Content="_Dark" GroupName="Appearance" IsChecked="{Binding IsDark}" AutomationProperties.Name="Dark appearance"/></WrapPanel>
    </StackPanel>
   </ContentControl>
   <ContentControl Style="{DynamicResource Card}" Margin="{DynamicResource MarginSection}">
    <StackPanel>
     <TextBlock Text="Global appearance" Style="{DynamicResource Caption}"/>
     <Label Content="Brand accent" Target="{Binding ElementName=AccentPicker}" Foreground="{DynamicResource TextSecondary}"/><ComboBox x:Name="AccentPicker" IsEnabled="{Binding CanCustomize}" ItemsSource="{Binding AccentChoices}" SelectedItem="{Binding SelectedAccent}" AutomationProperties.Name="Brand accent" Margin="{DynamicResource MarginItem}"/>
     <Label Content="Canvas tint" Foreground="{DynamicResource TextSecondary}"/><ComboBox ItemsSource="{Binding CanvasChoices}" SelectedItem="{Binding SelectedCanvas}" AutomationProperties.Name="Canvas tint" Margin="{DynamicResource MarginItem}"/>
     <Label Content="Surface style" Foreground="{DynamicResource TextSecondary}"/><ComboBox ItemsSource="{Binding SurfaceChoices}" SelectedItem="{Binding SelectedSurface}" AutomationProperties.Name="Surface style" Margin="{DynamicResource MarginItem}"/>
     <Label Content="Text contrast" Foreground="{DynamicResource TextSecondary}"/><ComboBox ItemsSource="{Binding TextContrastChoices}" SelectedItem="{Binding SelectedTextContrast}" AutomationProperties.Name="Text contrast" Margin="{DynamicResource MarginItem}"/>
     <Label Content="Border intensity" Foreground="{DynamicResource TextSecondary}"/><ComboBox ItemsSource="{Binding BorderChoices}" SelectedItem="{Binding SelectedBorder}" AutomationProperties.Name="Border intensity" Margin="{DynamicResource MarginItem}"/>
     <Label Content="Shadow intensity" Foreground="{DynamicResource TextSecondary}"/><ComboBox ItemsSource="{Binding ShadowChoices}" SelectedItem="{Binding SelectedShadow}" AutomationProperties.Name="Shadow intensity" Margin="{DynamicResource MarginItem}"/>
    </StackPanel>
   </ContentControl>
   <ContentControl Style="{DynamicResource Card}" Margin="{DynamicResource MarginSection}">
    <StackPanel>
     <TextBlock Text="Density and type" Style="{DynamicResource Caption}"/>
     <Label Content="Density" Target="{Binding ElementName=DensityPicker}" Foreground="{DynamicResource TextSecondary}"/><ComboBox x:Name="DensityPicker" IsEnabled="{Binding CanCustomize}" ItemsSource="{Binding DensityChoices}" SelectedItem="{Binding SelectedDensity}" AutomationProperties.Name="Control density" Margin="{DynamicResource MarginItem}"/>
     <Label Content="Spacing" Foreground="{DynamicResource TextSecondary}"/><ComboBox ItemsSource="{Binding SpacingChoices}" SelectedItem="{Binding SelectedSpacing}" AutomationProperties.Name="Grid spacing" Margin="{DynamicResource MarginItem}"/>
     <Label Content="Corner treatment" Target="{Binding ElementName=ShapePicker}" Foreground="{DynamicResource TextSecondary}"/><ComboBox x:Name="ShapePicker" IsEnabled="{Binding CanCustomize}" ItemsSource="{Binding ShapeChoices}" SelectedItem="{Binding SelectedShape}" AutomationProperties.Name="Corner treatment" Margin="{DynamicResource MarginItem}"/>
     <Label Content="Card padding" Foreground="{DynamicResource TextSecondary}"/><ComboBox ItemsSource="{Binding PaddingChoices}" SelectedItem="{Binding SelectedPadding}" AutomationProperties.Name="Card padding" Margin="{DynamicResource MarginItem}"/>
     <Label Content="Typography" Target="{Binding ElementName=TypePicker}" Foreground="{DynamicResource TextSecondary}"/><ComboBox x:Name="TypePicker" IsEnabled="{Binding CanCustomize}" ItemsSource="{Binding TypeChoices}" SelectedItem="{Binding SelectedTypography}" AutomationProperties.Name="Type scale" Margin="{DynamicResource MarginItem}"/>
     <Label Content="Font weight" Foreground="{DynamicResource TextSecondary}"/><ComboBox ItemsSource="{Binding WeightChoices}" SelectedItem="{Binding SelectedWeight}" AutomationProperties.Name="Font weight" Margin="{DynamicResource MarginItem}"/>
    </StackPanel>
   </ContentControl>
   <ContentControl Style="{DynamicResource Card}" Margin="{DynamicResource MarginSection}">
    <StackPanel>
     <TextBlock Text="Bento layout" Style="{DynamicResource Caption}"/>
     <Label Content="Layout preset" Foreground="{DynamicResource TextSecondary}"/><ComboBox ItemsSource="{Binding LayoutPresetChoices}" SelectedItem="{Binding SelectedLayoutPreset}" AutomationProperties.Name="Layout preset" Margin="{DynamicResource MarginItem}"/>
     <CheckBox Content="Compact hero span" IsChecked="{Binding HeroCompact}" AutomationProperties.Name="Compact hero" Margin="{DynamicResource MarginItem}"/>
     <CheckBox Content="Show KPI trend" IsChecked="{Binding ShowKpiTrend}" AutomationProperties.Name="Show KPI trend" Margin="{DynamicResource MarginItem}"/>
     <TextBlock Text="Executive: hero 2col + KPI 4up · Analytics Focus: hides activity, widens charts · Production Ops: strong borders, high contrast · Compact Data Dense: stacks, hides table." Style="{DynamicResource Caption}"/>
    </StackPanel>
   </ContentControl>
   <ContentControl Style="{DynamicResource Card}" Margin="{DynamicResource MarginSection}">
    <StackPanel>
     <TextBlock Text="Save and reset" Style="{DynamicResource Caption}"/>
     <WrapPanel Margin="{DynamicResource MarginItem}">
      <Button Content="Apply" Command="{Binding ApplyPreview}" Style="{DynamicResource PrimaryButton}" Margin="{DynamicResource MarginInline}" AutomationProperties.Name="Apply preview"/>
      <Button Content="Save" Command="{Binding SaveCustomization}" Margin="{DynamicResource MarginInline}" AutomationProperties.Name="Save to disk"/>
      <Button Content="Discard" Command="{Binding DiscardChanges}" Margin="{DynamicResource MarginInline}" AutomationProperties.Name="Discard unsaved changes"/>
     </WrapPanel>
     <WrapPanel Margin="{DynamicResource MarginItem}">
      <Button Content="Preview default" Command="{Binding PreviewDefault}" Margin="{DynamicResource MarginInline}" AutomationProperties.Name="Preview default comparison"/>
      <Button Content="Reset section" Command="{Binding ResetSection}" Margin="{DynamicResource MarginInline}" AutomationProperties.Name="Reset current section"/>
      <Button Content="Reset theme" Command="{Binding ResetTheme}" Style="{DynamicResource DestructiveButton}" Margin="{DynamicResource MarginInline}" AutomationProperties.Name="Reset theme to defaults"/>
     </WrapPanel>
     <TextBlock Text="{Binding ThemeError}" Foreground="{DynamicResource StatusError}" AutomationProperties.LiveSetting="Assertive" Margin="{DynamicResource MarginItem}"/>
     <TextBlock Text="Category for contextual panel on the right:" Style="{DynamicResource Caption}"/>
     <ComboBox ItemsSource="{Binding AvailableCategories}" SelectedItem="{Binding CustomizationCategory}" AutomationProperties.Name="Customization category" Margin="{DynamicResource MarginItem}"/>
    </StackPanel>
   </ContentControl>
   <ContentControl Style="{DynamicResource Card}" Margin="{DynamicResource MarginSection}">
    <StackPanel>
     <TextBlock Text="Presets — built-in stay protected" Style="{DynamicResource Caption}"/>
     <ListBox ItemsSource="{Binding BuiltInPresets}" DisplayMemberPath="Name" AutomationProperties.Name="Built-in presets" Margin="{DynamicResource MarginItem}"/>
     <ListBox ItemsSource="{Binding CustomPresets}" DisplayMemberPath="Name" AutomationProperties.Name="Your saved presets" Margin="{DynamicResource MarginItem}"/>
     <DockPanel Margin="{DynamicResource MarginItem}"><TextBox Width="120" Text="{Binding PresetNameInput, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="New preset name" Margin="{DynamicResource MarginInline}"/><Button Content="Save preset" Command="{Binding SavePreset}" AutomationProperties.Name="Save as preset"/></DockPanel>
     <Button Visibility="Collapsed" Command="{Binding ResetDesign}" AutomationProperties.Name="Legacy reset design binding"/>
     <WrapPanel Margin="{DynamicResource MarginItem}"><Button Content="Open reference" Command="{Binding ShowBusiness}" Style="{DynamicResource PrimaryButton}"/></WrapPanel>
    </StackPanel>
   </ContentControl>
  </StackPanel>
 </ScrollViewer>
</UserControl>
