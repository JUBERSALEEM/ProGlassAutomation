<UserControl x:Class="ProGlassAutomation.ThemeStudio.CustomizationPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ProGlassAutomation.ThemeStudio">
 <Border Style="{DynamicResource Card}"><StackPanel>
  <DockPanel Margin="{DynamicResource MarginItem}"><TextBlock Text="Design settings" Style="{DynamicResource SectionHeading}" /><Border Tag="Success" Style="{DynamicResource StatusBadge}" HorizontalAlignment="Right"><TextBlock Text="LIVE" Foreground="{DynamicResource StatusSuccess}" Style="{DynamicResource Caption}" /></Border></DockPanel>
  <TextBlock Text="One engine. Both pages. Changes apply immediately and remain local to this session." Style="{DynamicResource Caption}" Margin="{DynamicResource MarginSection}" />
  <Label Content="Theme" Target="{Binding ElementName=ThemePicker}" Foreground="{DynamicResource TextSecondary}" />
  <ComboBox x:Name="ThemePicker" ItemsSource="{Binding InstalledThemes}" SelectedItem="{Binding SelectedTheme}" AutomationProperties.Name="Installed theme" Margin="{DynamicResource MarginItem}" />
  <TextBlock Text="Appearance" Style="{DynamicResource Caption}" />
  <WrapPanel Margin="{DynamicResource MarginItem}"><RadioButton Content="_Light" GroupName="Appearance" IsChecked="{Binding IsLight}" AutomationProperties.Name="Light appearance" /><RadioButton Content="_Dark" GroupName="Appearance" IsChecked="{Binding IsDark}" AutomationProperties.Name="Dark appearance" /></WrapPanel>
  <Separator />
  <Label Content="Brand accent" Target="{Binding ElementName=AccentPicker}" Foreground="{DynamicResource TextSecondary}" />
  <ComboBox x:Name="AccentPicker" IsEnabled="{Binding CanCustomize}" ItemsSource="{Binding AccentChoices}" SelectedItem="{Binding SelectedAccent}" AutomationProperties.Name="Brand accent" Margin="{DynamicResource MarginItem}" />
  <Label Content="Density" Target="{Binding ElementName=DensityPicker}" Foreground="{DynamicResource TextSecondary}" />
  <ComboBox x:Name="DensityPicker" IsEnabled="{Binding CanCustomize}" ItemsSource="{Binding DensityChoices}" SelectedItem="{Binding SelectedDensity}" AutomationProperties.Name="Control density" Margin="{DynamicResource MarginItem}" />
  <Label Content="Corner treatment" Target="{Binding ElementName=ShapePicker}" Foreground="{DynamicResource TextSecondary}" />
  <ComboBox x:Name="ShapePicker" IsEnabled="{Binding CanCustomize}" ItemsSource="{Binding ShapeChoices}" SelectedItem="{Binding SelectedShape}" AutomationProperties.Name="Corner treatment" Margin="{DynamicResource MarginItem}" />
  <Label Content="Typography" Target="{Binding ElementName=TypePicker}" Foreground="{DynamicResource TextSecondary}" />
  <ComboBox x:Name="TypePicker" IsEnabled="{Binding CanCustomize}" ItemsSource="{Binding TypeChoices}" SelectedItem="{Binding SelectedTypography}" AutomationProperties.Name="Type scale" Margin="{DynamicResource MarginSection}" />
  <WrapPanel><Button Content="_Reset design" Command="{Binding ResetDesign}" Margin="{DynamicResource MarginInline}" /><Button Content="Open reference" Command="{Binding ShowBusiness}" Style="{DynamicResource PrimaryButton}" /></WrapPanel>
  <TextBlock Text="{Binding ThemeError}" Foreground="{DynamicResource StatusError}" AutomationProperties.LiveSetting="Assertive" Margin="{DynamicResource MarginItem}" />
 </StackPanel></Border>
</UserControl>
