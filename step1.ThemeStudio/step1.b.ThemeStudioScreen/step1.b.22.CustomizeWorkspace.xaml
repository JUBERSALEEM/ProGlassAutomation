<UserControl x:Class="ProGlassAutomation.ThemeStudio.CustomizeWorkspace" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ProGlassAutomation.ThemeStudio">
 <UserControl.Resources>
  <local:BoolToVisibilityConverter2 x:Key="BoolToVisibility"/>
  <local:CategoryVisibilityConverter x:Key="CategoryVisibilityConverter"/>
  <BooleanToVisibilityConverter x:Key="ShowDiagnostics"/>
 </UserControl.Resources>
 <Border Style="{DynamicResource Card}" Margin="{DynamicResource MarginSection}">
  <Grid x:Name="WorkspaceGrid" SizeChanged="WorkspaceGrid_SizeChanged">
   <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="3*"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <!-- LEFT: categories + presets -->
   <Border Grid.RowSpan="3" Style="{DynamicResource Plate}" Margin="{DynamicResource MarginPanel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
     <TextBlock Text="Customize" Style="{DynamicResource SectionHeading}" Margin="{DynamicResource MarginItem}"/>
     <TextBlock Text="Left: choose area. Center: live preview. Right: contextual edits." Style="{DynamicResource Caption}" Margin="{DynamicResource MarginItem}"/>
     <Label Content="Category" Target="{Binding ElementName=CategoryList}" Foreground="{DynamicResource TextSecondary}"/>
     <ComboBox x:Name="CategoryList" ItemsSource="{Binding AvailableCategories}" SelectedItem="{Binding CustomizationCategory}" AutomationProperties.Name="Customization category"/>
     <Separator Margin="{DynamicResource MarginItem}"/>
     <TextBlock Text="Bento Layout Presets" Style="{DynamicResource Caption}"/>
     <ListBox ItemsSource="{Binding BuiltInPresets}" DisplayMemberPath="Name" AutomationProperties.Name="Built-in layout presets" Margin="{DynamicResource MarginItem}">
      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="AutomationProperties.Name" Value="{Binding Name}"/></Style></ListBox.ItemContainerStyle>
     </ListBox>
     <TextBlock Text="Your presets (saved to disk)" Style="{DynamicResource Caption}" Margin="{DynamicResource MarginItem}"/>
     <ListBox ItemsSource="{Binding CustomPresets}" DisplayMemberPath="Name" AutomationProperties.Name="Your custom presets" Margin="{DynamicResource MarginItem}"/>
     <DockPanel Margin="{DynamicResource MarginItem}"><TextBox x:Name="PresetNameBox" Text="{Binding PresetNameInput, UpdateSourceTrigger=PropertyChanged}" Width="160" AutomationProperties.Name="New preset name" Margin="{DynamicResource MarginInline}"/><Button Content="Save as preset" Command="{Binding SavePreset}" AutomationProperties.Name="Save current as preset"/></DockPanel>
     <TextBlock Text="{Binding ThemeError}" Foreground="{DynamicResource StatusError}" Margin="{DynamicResource MarginItem}"/>
    </StackPanel></ScrollViewer>
   </Border>
   <!-- CENTER: live preview -->
   <Border Grid.Column="1" Style="{DynamicResource Card}" Margin="{DynamicResource MarginPanel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="PreviewStack">
     <TextBlock Text="LIVE PREVIEW — every change updates immediately" Style="{DynamicResource Caption}"/>
     <UniformGrid Columns="2" Margin="{DynamicResource MarginItem}">
      <Border Style="{DynamicResource PositivePlate}" Margin="{DynamicResource MarginPanel}" Tag="KpiRevenue" MouseDown="PreviewCard_MouseDown"><StackPanel><TextBlock Text="Revenue" Style="{DynamicResource SectionHeading}"/><TextBlock Text="AED 284k" FontSize="{DynamicResource FontSizeTitle}" FontWeight="{DynamicResource FontWeightHeading}"/><TextBlock x:Name="TrendText" Text="↑ 6.4% trend visible" Style="{DynamicResource Caption}" Visibility="{Binding ShowKpiTrend, Converter={StaticResource BoolToVisibility}}"/></StackPanel></Border>
      <Border Style="{DynamicResource FeaturePlate}" Margin="{DynamicResource MarginPanel}" Tag="KpiOrders" MouseDown="PreviewCard_MouseDown"><StackPanel><TextBlock Text="Orders" Style="{DynamicResource SectionHeading}"/><TextBlock Text="128" FontSize="{DynamicResource FontSizeTitle}" FontWeight="{DynamicResource FontWeightHeading}"/><TextBlock Text="Feature plate example" Style="{DynamicResource Caption}"/></StackPanel></Border>
     </UniformGrid>
     <Border x:Name="HeroPreview" Style="{DynamicResource HeroCard}" Margin="{DynamicResource MarginPanel}" Tag="Hero" MouseDown="PreviewCard_MouseDown"><StackPanel><TextBlock Text="Hero workspace" Foreground="{DynamicResource HeroForeground}" Style="{DynamicResource SectionHeading}"/><TextBlock Text="Span and compact toggle live in Layout settings." Foreground="{DynamicResource HeroSecondaryText}"/></StackPanel></Border>
     <local:AnalyticsOverview x:Name="LiveOverview" Margin="{DynamicResource MarginPanel}"/>
     <TextBlock Text="{Binding ContextualTitle}" Style="{DynamicResource Caption}" Margin="{DynamicResource MarginItem}"/>
    </StackPanel></ScrollViewer>
   </Border>
   <!-- RIGHT: contextual -->
   <Border Grid.Column="2" Grid.RowSpan="3" Style="{DynamicResource Plate}" Margin="{DynamicResource MarginPanel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
     <TextBlock Text="Contextual" Style="{DynamicResource SectionHeading}"/>
     <TextBlock Text="{Binding ContextualTitle}" Style="{DynamicResource Caption}" Margin="{DynamicResource MarginItem}"/>
     <!-- Appearance contextual -->
     <StackPanel Visibility="{Binding CustomizationCategory, Converter={StaticResource CategoryVisibilityConverter}, ConverterParameter=Appearance}">
      <Label Content="Canvas tint" Target="{Binding ElementName=CanvasPicker}" Foreground="{DynamicResource TextSecondary}"/><ComboBox x:Name="CanvasPicker" ItemsSource="{Binding CanvasChoices}" SelectedItem="{Binding SelectedCanvas}" AutomationProperties.Name="Canvas tint"/>
      <Label Content="Surface style" Foreground="{DynamicResource TextSecondary}"/><ComboBox ItemsSource="{Binding SurfaceChoices}" SelectedItem="{Binding SelectedSurface}" AutomationProperties.Name="Surface style"/>
      <Label Content="Accent" Foreground="{DynamicResource TextSecondary}"/><ComboBox ItemsSource="{Binding AccentChoices}" SelectedItem="{Binding SelectedAccent}" AutomationProperties.Name="Accent choice"/>
      <Label Content="Text contrast" Foreground="{DynamicResource TextSecondary}"/><ComboBox ItemsSource="{Binding TextContrastChoices}" SelectedItem="{Binding SelectedTextContrast}" AutomationProperties.Name="Text contrast"/>
      <Label Content="Border intensity" Foreground="{DynamicResource TextSecondary}"/><ComboBox ItemsSource="{Binding BorderChoices}" SelectedItem="{Binding SelectedBorder}" AutomationProperties.Name="Border intensity"/>
      <Label Content="Shadow intensity" Foreground="{DynamicResource TextSecondary}"/><ComboBox ItemsSource="{Binding ShadowChoices}" SelectedItem="{Binding SelectedShadow}" AutomationProperties.Name="Shadow intensity"/>
      <Label Content="Corner treatment" Foreground="{DynamicResource TextSecondary}"/><ComboBox ItemsSource="{Binding ShapeChoices}" SelectedItem="{Binding SelectedShape}" AutomationProperties.Name="Corner treatment"/>
      <Label Content="Typography size" Foreground="{DynamicResource TextSecondary}"/><ComboBox ItemsSource="{Binding TypeChoices}" SelectedItem="{Binding SelectedTypography}" AutomationProperties.Name="Typography size"/>
      <Label Content="Font weight" Foreground="{DynamicResource TextSecondary}"/><ComboBox ItemsSource="{Binding WeightChoices}" SelectedItem="{Binding SelectedWeight}" AutomationProperties.Name="Font weight"/>
      <Label Content="Spacing" Foreground="{DynamicResource TextSecondary}"/><ComboBox ItemsSource="{Binding SpacingChoices}" SelectedItem="{Binding SelectedSpacing}" AutomationProperties.Name="Spacing density"/>
      <Label Content="Card padding" Foreground="{DynamicResource TextSecondary}"/><ComboBox ItemsSource="{Binding PaddingChoices}" SelectedItem="{Binding SelectedPadding}" AutomationProperties.Name="Card padding"/>
      <Label Content="Density" Foreground="{DynamicResource TextSecondary}"/><ComboBox ItemsSource="{Binding DensityChoices}" SelectedItem="{Binding SelectedDensity}" AutomationProperties.Name="Overall density"/>
     </StackPanel>
     <!-- Layout contextual -->
     <StackPanel Visibility="{Binding CustomizationCategory, Converter={StaticResource CategoryVisibilityConverter}, ConverterParameter=Layout}">
      <Label Content="Layout preset" Foreground="{DynamicResource TextSecondary}"/><ComboBox ItemsSource="{Binding LayoutPresetChoices}" SelectedItem="{Binding SelectedLayoutPreset}" AutomationProperties.Name="Layout preset"/>
      <CheckBox Content="Compact hero" IsChecked="{Binding HeroCompact}" AutomationProperties.Name="Compact hero toggle"/>
      <CheckBox Content="Show KPI trend" IsChecked="{Binding ShowKpiTrend}" AutomationProperties.Name="Show KPI trend"/>
      <Label Content="Spacing" Foreground="{DynamicResource TextSecondary}"/><ComboBox ItemsSource="{Binding SpacingChoices}" SelectedItem="{Binding SelectedSpacing}" AutomationProperties.Name="Grid gaps"/>
      <Label Content="Card padding" Foreground="{DynamicResource TextSecondary}"/><ComboBox ItemsSource="{Binding PaddingChoices}" SelectedItem="{Binding SelectedPadding}" AutomationProperties.Name="Card padding layout"/>
      <Label Content="Corner radius" Foreground="{DynamicResource TextSecondary}"/><ComboBox ItemsSource="{Binding ShapeChoices}" SelectedItem="{Binding SelectedShape}" AutomationProperties.Name="Card corner radius layout"/>
      <TextBlock Text="Presets move/resize/hide cards — Executive shows elevated hero + 2-column KPI, Analytics Focus hides activity, Compact Data Dense collapses hero and stacks charts." Style="{DynamicResource Caption}" Margin="{DynamicResource MarginItem}"/>
      <Button Content="Reset layout to defaults" Command="{Binding ResetSection}" AutomationProperties.Name="Reset current section"/>
     </StackPanel>
     <!-- Components contextual -->
     <StackPanel Visibility="{Binding CustomizationCategory, Converter={StaticResource CategoryVisibilityConverter}, ConverterParameter=Components}">
      <TextBlock Text="Select a card in the center preview to edit its plate, size, icon and border." Style="{DynamicResource Caption}"/>
      <Label Content="Component plate" Foreground="{DynamicResource TextSecondary}"/><ComboBox ItemsSource="{Binding CanvasChoices}" SelectedItem="{Binding SelectedCanvas}" AutomationProperties.Name="Component plate (uses appearance plates)"/>
      <CheckBox Content="Compact presentation" IsChecked="{Binding HeroCompact}" AutomationProperties.Name="Compact presentation"/>
     </StackPanel>
     <!-- Charts contextual -->
     <StackPanel Visibility="{Binding CustomizationCategory, Converter={StaticResource CategoryVisibilityConverter}, ConverterParameter=Charts}">
      <local:ChartLab x:Name="ChartLabPanel" DataContext="{Binding ChartEditor}"/>
     </StackPanel>
     <Separator Margin="{DynamicResource MarginItem}"/>
     <WrapPanel>
      <Button Content="Apply" Command="{Binding ApplyPreview}" Style="{DynamicResource PrimaryButton}" Margin="{DynamicResource MarginInline}" AutomationProperties.Name="Apply to theme"/>
      <Button Content="Save" Command="{Binding SaveCustomization}" Margin="{DynamicResource MarginInline}" AutomationProperties.Name="Save to disk"/>
      <Button Content="Discard" Command="{Binding DiscardChanges}" Margin="{DynamicResource MarginInline}" AutomationProperties.Name="Discard unsaved changes"/>
      <Button Content="Preview default" Command="{Binding PreviewDefault}" Margin="{DynamicResource MarginInline}" AutomationProperties.Name="Toggle preview default"/>
      <Button Content="Reset section" Command="{Binding ResetSection}" Margin="{DynamicResource MarginInline}" AutomationProperties.Name="Reset current section"/>
      <Button Content="Reset theme" Command="{Binding ResetTheme}" Style="{DynamicResource DestructiveButton}" Margin="{DynamicResource MarginInline}" AutomationProperties.Name="Reset theme to defaults"/>
     </WrapPanel>
     <TextBlock Text="Unsaved changes are preview-only. Save persists versioned JSON to LocalAppData — never overwrites built-in presets. Corrupt file falls back to defaults." Style="{DynamicResource Caption}" Margin="{DynamicResource MarginItem}"/>
     <TextBlock Text="{Binding ThemeError}" Foreground="{DynamicResource StatusError}"/>
    </StackPanel></ScrollViewer>
   </Border>
   <!-- bottom status bar spanning all -->
   <Border Grid.Row="2" Grid.ColumnSpan="3" Style="{DynamicResource Plate}" Margin="{DynamicResource MarginPanel}"><DockPanel><TextBlock Text="{Binding DesignSummary}" Style="{DynamicResource Caption}" VerticalAlignment="Center"/><Border DockPanel.Dock="Right" Style="{DynamicResource StatusBadge}" Tag="Information" Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="Unsaved changes" Style="{DynamicResource StatusText}" Tag="Information"/></Border></DockPanel></Border>
  </Grid>
 </Border>
</UserControl>
