<UserControl x:Class="ProGlassAutomation.ThemeStudio.BusinessReferenceView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ProGlassAutomation.ThemeStudio" xmlns:bento="clr-namespace:ProGlassAutomation.ThemeBento">
 <Grid Background="{DynamicResource ApplicationBackground}">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
  </Grid.RowDefinitions>
  <DockPanel Grid.Row="0" Margin="{DynamicResource PaddingPage}">
   <Border DockPanel.Dock="Right" Style="{DynamicResource AccentPlate}"><TextBlock Text="{Binding AppearanceLabel, StringFormat='Bento {0} / sample workspace'}" Foreground="{DynamicResource AccentPrimary}" /></Border>
   <StackPanel>
    <TextBlock Text="PROGLASS / BUSINESS REFERENCE" Style="{DynamicResource Caption}" />
    <TextBlock Text="Workspace overview" FontSize="{DynamicResource FontSizeTitle}" FontWeight="{DynamicResource FontWeightHeading}" />
    <TextBlock Text="Illustrative work only. No business records or services." Style="{DynamicResource Caption}" />
   </StackPanel>
  </DockPanel>
  <bento:BentoGrid x:Name="BusinessModules" Grid.Row="1" Columns="4" FillAvailable="True"
                   RowHeight="{DynamicResource BentoRowHeight}" Gutter="{DynamicResource BentoGutter}" CompactWidth="{DynamicResource BentoCompactWidth}"
                   Margin="{DynamicResource PaddingPage}">
   <local:OverviewPanel x:Name="Hero" bento:BentoGrid.Column="0" bento:BentoGrid.Row="0" bento:BentoGrid.ColumnSpan="2" bento:BentoGrid.RowSpan="2" />
   <local:AppearancePanel x:Name="Health" bento:BentoGrid.Column="2" bento:BentoGrid.Row="0" bento:BentoGrid.ColumnSpan="2" bento:BentoGrid.RowSpan="2" />
   <local:AnalyticsOverview x:Name="Analytics" bento:BentoGrid.Column="0" bento:BentoGrid.Row="2" bento:BentoGrid.ColumnSpan="4" bento:BentoGrid.RowSpan="5" />
   <local:WorklistPanel x:Name="Work" bento:BentoGrid.Column="0" bento:BentoGrid.Row="7" bento:BentoGrid.ColumnSpan="2" bento:BentoGrid.RowSpan="2" />
   <local:ControlsPanel x:Name="Details" bento:BentoGrid.Column="2" bento:BentoGrid.Row="7" bento:BentoGrid.ColumnSpan="2" bento:BentoGrid.RowSpan="2" />
   <local:SurfacesPanel x:Name="Layers" bento:BentoGrid.Column="0" bento:BentoGrid.Row="9" bento:BentoGrid.ColumnSpan="4" bento:BentoGrid.RowSpan="1" />
  </bento:BentoGrid>
 </Grid>
</UserControl>
