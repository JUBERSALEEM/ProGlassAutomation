<UserControl x:Class="ProGlassAutomation.ThemeStudio.BusinessReferenceView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ProGlassAutomation.ThemeStudio">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="{DynamicResource PaddingPage}">
  <DockPanel Margin="{DynamicResource MarginSection}"><Border DockPanel.Dock="Right" Style="{DynamicResource AccentPlate}"><TextBlock Text="{Binding AppearanceLabel, StringFormat='Bento {0} / sample workspace'}" Foreground="{DynamicResource AccentPrimary}" /></Border><StackPanel><TextBlock Text="PROGLASS / BUSINESS REFERENCE" Style="{DynamicResource Caption}" /><TextBlock Text="Workspace overview" FontSize="{DynamicResource FontSizeTitle}" FontWeight="{DynamicResource FontWeightHeading}" /><TextBlock Text="Illustrative work only. No business records or services." Style="{DynamicResource Caption}" /></StackPanel></DockPanel>
  <local:MetricsPanel Margin="{DynamicResource MarginSection}" />
  <Grid x:Name="BusinessModules" SizeChanged="BusinessModules_SizeChanged">
   <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition /></Grid.ColumnDefinitions>
   <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
   <local:OverviewPanel x:Name="Hero" Margin="{DynamicResource MarginPanel}" />
   <local:AppearancePanel x:Name="Health" Grid.Column="1" Margin="{DynamicResource MarginPanel}" />
   <local:WorklistPanel x:Name="Work" Grid.Row="1" Margin="{DynamicResource MarginPanel}" />
   <local:ControlsPanel x:Name="Details" Grid.Row="1" Grid.Column="1" Margin="{DynamicResource MarginPanel}" />
   <local:SurfacesPanel x:Name="Layers" Grid.Row="2" Grid.ColumnSpan="2" Margin="{DynamicResource MarginPanel}" />
  </Grid>
 </StackPanel></ScrollViewer>
</UserControl>
