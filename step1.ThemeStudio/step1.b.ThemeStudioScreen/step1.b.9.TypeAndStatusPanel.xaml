<UserControl x:Class="ProGlassAutomation.ThemeStudio.TypeAndStatusPanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Border Style="{DynamicResource Card}"><StackPanel>
  <TextBlock Text="04 / TYPE &amp; SIGNAL" Style="{DynamicResource Caption}" Margin="{DynamicResource MarginItem}" />
  <TextBlock Text="Built to be read." Style="{DynamicResource SectionHeading}" />
  <TextBlock Text="Heading / 24" FontSize="{DynamicResource FontSizeTitle}" FontWeight="{DynamicResource FontWeightHeading}" Margin="{DynamicResource MarginItem}" />
  <TextBlock Text="Body / A clear hierarchy makes complex work feel simple." Margin="{DynamicResource MarginItem}" />
  <TextBlock Text="Caption / supporting information" Style="{DynamicResource Caption}" Margin="{DynamicResource MarginSection}" />
  <StackPanel>
   <Border Style="{DynamicResource Plate}" Background="{DynamicResource StatusSuccessSurface}" Margin="{DynamicResource MarginItem}"><TextBlock Text="Success / Ready for review" Foreground="{DynamicResource StatusSuccess}" /></Border>
   <Border Style="{DynamicResource Plate}" Background="{DynamicResource StatusWarningSurface}" Margin="{DynamicResource MarginItem}"><TextBlock Text="Warning / Check before continuing" Foreground="{DynamicResource StatusWarning}" /></Border>
   <Border Style="{DynamicResource Plate}" Background="{DynamicResource StatusErrorSurface}" Margin="{DynamicResource MarginItem}"><TextBlock Text="Error / A field needs attention" Foreground="{DynamicResource StatusError}" /></Border>
   <Border Style="{DynamicResource Plate}" Background="{DynamicResource StatusInformationSurface}"><TextBlock Text="Information / Preview data only" Foreground="{DynamicResource StatusInformation}" /></Border>
  </StackPanel>
 </StackPanel></Border>
</UserControl>
