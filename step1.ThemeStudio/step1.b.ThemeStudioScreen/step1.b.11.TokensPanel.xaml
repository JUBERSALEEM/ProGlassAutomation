<UserControl x:Class="ProGlassAutomation.ThemeStudio.TokensPanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Border Style="{DynamicResource Card}"><StackPanel>
  <TextBlock Text="OPTIONAL / RESOURCE DIAGNOSTICS" Style="{DynamicResource Caption}" Margin="{DynamicResource MarginItem}" />
  <TextBlock Text="Inspect active semantic resources." Style="{DynamicResource SectionHeading}" />
  <TextBlock Text="These values come from the active resource dictionary. Switch appearances to see the same semantic names resolve to new values." Foreground="{DynamicResource TextSecondary}" Margin="{DynamicResource MarginItem}" />
  <Label Content="Filter tokens by semantic name" Target="{Binding ElementName=TokenSearch}" Foreground="{DynamicResource TextSecondary}" />
  <TextBox x:Name="TokenSearch" Text="{Binding TokenFilter, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Filter semantic tokens" Margin="{DynamicResource MarginSection}" />
  <ScrollViewer MaxHeight="{DynamicResource ReferenceListMaxHeight}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Scrollable semantic resource reference">
  <ItemsControl ItemsSource="{Binding TokenView}">
   <ItemsControl.ItemTemplate><DataTemplate>
    <Border Style="{DynamicResource Plate}" Margin="{DynamicResource MarginItem}">
     <DockPanel>
      <Border DockPanel.Dock="Left" Background="{Binding Preview}" Width="{DynamicResource ChoiceMarkSize}" Height="{DynamicResource ChoiceMarkSize}" BorderBrush="{DynamicResource BorderStrong}" BorderThickness="{DynamicResource BorderThicknessControl}" CornerRadius="{DynamicResource ChipCornerRadius}" Margin="{DynamicResource MarginInline}" VerticalAlignment="Center" />
      <StackPanel><TextBlock Text="{Binding Name}" FontWeight="{DynamicResource FontWeightHeading}" /><WrapPanel><TextBlock Text="{Binding Kind}" Style="{DynamicResource Caption}" Margin="{DynamicResource MarginInline}" /><TextBlock Text="{Binding Value}" Style="{DynamicResource TokenValue}" /></WrapPanel></StackPanel>
     </DockPanel>
    </Border>
   </DataTemplate></ItemsControl.ItemTemplate>
  </ItemsControl>
  </ScrollViewer>
 </StackPanel></Border>
</UserControl>
