<UserControl x:Class="ProGlassAutomation.ThemeStudio.ChartGallery" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ProGlassAutomation.ThemeStudio" xmlns:analytics="clr-namespace:ProGlassAutomation.Analytics" xmlns:bento="clr-namespace:ProGlassAutomation.ThemeBento">
 <UserControl.Resources><local:AnalyticsSamples x:Key="Samples" /></UserControl.Resources>
 <ContentControl Style="{DynamicResource Card}" DataContext="{StaticResource Samples}">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <StackPanel>
    <TextBlock Text="Chart laboratory" Style="{DynamicResource SectionHeading}" />
    <TextBlock Text="REAL WPF CHARTS / DETERMINISTIC DEMO DATA" Style="{DynamicResource Caption}" />
    <WrapPanel>
     <StackPanel Margin="{DynamicResource MarginPanel}"><Label Foreground="{DynamicResource TextSecondary}" Content="Chart _type" Target="{Binding ElementName=ChartType}" /><ComboBox x:Name="ChartType" ItemsSource="{Binding ChartKinds}" SelectedItem="{Binding SelectedKind}" AutomationProperties.Name="Chart type" /></StackPanel>
     <StackPanel Margin="{DynamicResource MarginPanel}"><Label Foreground="{DynamicResource TextSecondary}" Content="Data _scenario" Target="{Binding ElementName=Scenario}" /><ComboBox x:Name="Scenario" ItemsSource="{Binding Scenarios}" SelectedItem="{Binding SelectedScenario}" AutomationProperties.Name="Data scenario" /></StackPanel>
     <Button Content="_Reset demo / retry" Command="{Binding Reset}" VerticalAlignment="Center" />
    </WrapPanel>
   </StackPanel>
   <bento:BentoGrid Grid.Row="1" Columns="2" FillAvailable="True" RowHeight="{DynamicResource BentoRowHeight}" Gutter="{DynamicResource BentoGutter}" CompactWidth="{DynamicResource BentoCompactWidth}">
    <ContentControl Style="{DynamicResource ChartCard}" bento:BentoGrid.Column="0" bento:BentoGrid.Row="0"><StackPanel><TextBlock Text="Interactive preview" Style="{DynamicResource SectionHeading}" /><analytics:BentoChart Data="{Binding Preview}" /></StackPanel></ContentControl>
    <ContentControl x:Name="AreaCard" Style="{DynamicResource ChartCard}" bento:BentoGrid.Column="1" bento:BentoGrid.Row="0"><StackPanel><TextBlock Text="Multi-series / area" Style="{DynamicResource SectionHeading}" /><analytics:BentoChart Data="{Binding Area}" /></StackPanel></ContentControl>
    <ContentControl x:Name="StackCard" Style="{DynamicResource ChartCard}" bento:BentoGrid.Column="0" bento:BentoGrid.Row="1"><StackPanel><TextBlock Text="Stacked / capacity" Style="{DynamicResource SectionHeading}" /><analytics:BentoChart Data="{Binding Capacity}" /></StackPanel></ContentControl>
    <ContentControl x:Name="ChannelCard" Style="{DynamicResource ChartCard}" bento:BentoGrid.Column="1" bento:BentoGrid.Row="1"><StackPanel><TextBlock Text="Horizontal / channels" Style="{DynamicResource SectionHeading}" /><analytics:BentoChart Data="{Binding Channels}" /></StackPanel></ContentControl>
   </bento:BentoGrid>
  </Grid>
 </ContentControl>
</UserControl>
