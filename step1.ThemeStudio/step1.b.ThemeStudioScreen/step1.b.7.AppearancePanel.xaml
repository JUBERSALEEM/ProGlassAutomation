<UserControl x:Class="ProGlassAutomation.ThemeStudio.AppearancePanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Border Style="{DynamicResource Card}"><StackPanel>
  <TextBlock Text="02 / LIVE PREVIEW" Style="{DynamicResource Caption}" Margin="{DynamicResource MarginItem}" />
  <TextBlock Text="One system. Every window." Style="{DynamicResource SectionHeading}" />
  <TextBlock Text="{Binding ThemeError}" Foreground="{DynamicResource StatusError}" Margin="{DynamicResource MarginItem}" />
  <Border Style="{DynamicResource Plate}" Margin="{DynamicResource MarginItem}"><StackPanel>
   <TextBlock Text="{Binding AppearanceLabel, StringFormat='Active appearance: {0}'}" FontWeight="{DynamicResource FontWeightHeading}" />
   <TextBlock Text="Existing controls and open preview windows share the same application resources." Style="{DynamicResource Caption}" />
  </StackPanel></Border>
  <Button Content="Open _preview window" Command="{Binding OpenDialog}" ToolTip="Leave the preview open, then switch appearances." />
 </StackPanel></Border>
</UserControl>
