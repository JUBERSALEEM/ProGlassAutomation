<UserControl x:Class="ProGlassAutomation.ThemeStudio.AppearancePanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ContentControl Style="{DynamicResource Card}">
  <Grid>
   <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="*"/>
    <RowDefinition Height="Auto"/>
   </Grid.RowDefinitions>
   <DockPanel>
    <Border Tag="Success" Style="{DynamicResource StatusBadge}" DockPanel.Dock="Right" Margin="{DynamicResource MarginItem}"><TextBlock Text="● Live" Foreground="{DynamicResource StatusSuccess}" /></Border>
    <TextBlock Text="{Binding SelectedReference.Title}" FontWeight="{DynamicResource FontWeightHeading}" VerticalAlignment="Center" />
   </DockPanel>
   <TextBlock Grid.Row="1" Text="{Binding DesignSummary}" Style="{DynamicResource Caption}" TextWrapping="Wrap" />
   <Button Grid.Row="2" Content="Open _preview window" Command="{Binding OpenDialog}" ToolTip="Keep this window open while editing the design in Studio." HorizontalAlignment="Left" />
  </Grid>
 </ContentControl>
</UserControl>
