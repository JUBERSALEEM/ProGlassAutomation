<UserControl x:Class="ProGlassAutomation.ThemeStudio.MetricsPanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Border Style="{DynamicResource Card}"><StackPanel>
  <TextBlock Text="REFERENCE SNAPSHOT / SAMPLE VALUES" Style="{DynamicResource Caption}" />
  <TextBlock Text="A system ready for real work." Style="{DynamicResource SectionHeading}" />
  <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
   <Border Style="{DynamicResource AccentPlate}" Margin="{DynamicResource MarginInline}"><StackPanel><TextBlock Text="{Binding TokenCount}" Style="{DynamicResource PageHeading}" Foreground="{DynamicResource AccentPrimary}" /><TextBlock Text="Semantic resources" FontWeight="{DynamicResource FontWeightHeading}" /><TextBlock Text="One source of truth" Style="{DynamicResource Caption}" /></StackPanel></Border>
   <Border Grid.Column="1" Style="{DynamicResource Plate}" Margin="{DynamicResource MarginInline}"><StackPanel><TextBlock Text="02" Style="{DynamicResource PageHeading}" /><TextBlock Text="Appearance modes" FontWeight="{DynamicResource FontWeightHeading}" /><TextBlock Text="Independent Light + Dark" Style="{DynamicResource Caption}" /></StackPanel></Border>
   <Border Grid.Column="2" Style="{DynamicResource Plate}"><StackPanel><TextBlock Text="{Binding ReferenceItems.Count}" Style="{DynamicResource PageHeading}" /><TextBlock Text="Review patterns" FontWeight="{DynamicResource FontWeightHeading}" /><TextBlock Text="Illustrative, not live KPIs" Style="{DynamicResource Caption}" /></StackPanel></Border>
  </Grid>
 </StackPanel></Border>
</UserControl>
