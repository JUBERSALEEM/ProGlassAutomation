<UserControl x:Class="ProGlassAutomation.ThemeStudio.WorklistPanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Border Style="{DynamicResource Card}"><StackPanel>
  <TextBlock Text="REFERENCE WORKLIST / LOCAL SAMPLE DATA" Style="{DynamicResource Caption}" />
  <TextBlock Text="Readable at a glance." Style="{DynamicResource SectionHeading}" />
  <TextBlock Text="A structured list pattern for future screens. Select a row with the mouse or arrow keys; review actions only update this preview." Foreground="{DynamicResource TextSecondary}" Margin="{DynamicResource MarginItem}" />
  <Label Foreground="{DynamicResource TextSecondary}" Content="Search reference items" Target="{Binding ElementName=ReferenceSearch}" />
  <TextBox x:Name="ReferenceSearch" Text="{Binding ReferenceFilter, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search reference worklist" Margin="{DynamicResource MarginItem}" />
  <Border Style="{DynamicResource Plate}" Padding="{DynamicResource PaddingControl}" Margin="{DynamicResource MarginItem}"><Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
   <TextBlock Text="REFERENCE / OWNER" Style="{DynamicResource Caption}" /><TextBlock Grid.Column="1" Text="UPDATED" Style="{DynamicResource Caption}" /><TextBlock Grid.Column="2" Text="STATUS" Style="{DynamicResource Caption}" />
  </Grid></Border>
  <ListBox ItemsSource="{Binding ReferenceView}" SelectedItem="{Binding SelectedReference}" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Reference worklist">
   <ListBox.ItemTemplate><DataTemplate><Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
    <StackPanel Margin="{DynamicResource MarginInline}"><TextBlock Text="{Binding Title}" FontWeight="{DynamicResource FontWeightHeading}" /><TextBlock Text="{Binding Owner}" Style="{DynamicResource Caption}" /></StackPanel>
    <TextBlock Grid.Column="1" Text="{Binding Updated}" Style="{DynamicResource Caption}" VerticalAlignment="Center" />
    <TextBlock Grid.Column="2" Text="{Binding Status}" VerticalAlignment="Center" />
   </Grid></DataTemplate></ListBox.ItemTemplate>
  </ListBox>
  <TextBlock Text="{Binding ReferenceSummary}" Style="{DynamicResource Caption}" Margin="{DynamicResource MarginItem}" AutomationProperties.LiveSetting="Polite" />
  <Separator />
  <Border Style="{DynamicResource Plate}"><StackPanel>
   <TextBlock Text="Reference notes" FontWeight="{DynamicResource FontWeightHeading}" />
   <TextBlock Text="Use one clear heading, a short explanation and quiet metadata. Keep supporting actions secondary to the main workflow." Margin="{DynamicResource MarginItem}" />
   <TextBlock Text="Design operations · Reference edition 01 · Local preview" Style="{DynamicResource Caption}" />
   <WrapPanel Margin="{DynamicResource MarginItem}"><Button Content="Review selected pattern" Command="{Binding ReviewReference}" ToolTip="Reports the selected sample; no business data is changed." Margin="{DynamicResource MarginInline}" /><Button Content="Reference notes" Style="{DynamicResource SubtleButton}" Command="{Binding OpenDialog}" /></WrapPanel>
  </StackPanel></Border>
 </StackPanel></Border>
</UserControl>
