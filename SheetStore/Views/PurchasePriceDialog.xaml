<Window x:Class="ProGlassAutomation.SheetStore.Views.PurchasePriceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update Prices" Height="500" Width="600"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBox Grid.Row="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                 Padding="8" Margin="0,0,0,8" FontSize="12"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ListBox Grid.Column="0" ItemsSource="{Binding FilteredSheets}"
                     SelectedItem="{Binding SelectedSheet}" Margin="0,0,4,0"
                     DisplayMemberPath="Category" FontSize="11"/>

            <StackPanel Grid.Column="1" Margin="4,0,0,0" DataContext="{Binding SelectedSheet}">
                <TextBlock Text="Update Prices" FontSize="14" FontWeight="Bold" Margin="0,0,0,12"/>

                <TextBlock Text="New Purchase Price" FontWeight="SemiBold" Margin="0,6,0,4"/>
                <TextBox Text="{Binding DataContext.NewPurchasePrice, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                         Padding="6,4"/>

                <TextBlock Text="New Sell Price" FontWeight="SemiBold" Margin="0,12,0,4"/>
                <TextBox Text="{Binding DataContext.NewSellPrice, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                         Padding="6,4"/>

                <Button Content="Apply to Selected" Padding="12,8" Margin="0,16,0,0"
                        Background="#059669" Foreground="White" FontWeight="Bold"
                        Command="{Binding DataContext.ApplyCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
            </StackPanel>
        </Grid>

        <Button Grid.Row="2" Content="Close" Padding="16,8" HorizontalAlignment="Right" Margin="0,12,0,0"
                Click="Close_Click"/>
    </Grid>
</Window>