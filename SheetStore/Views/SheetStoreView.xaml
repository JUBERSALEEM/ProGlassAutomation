<UserControl x:Class="ProGlassAutomation.SheetStore.Views.SheetStoreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:ProGlassAutomation.Converters"
             xmlns:vm="clr-namespace:ProGlassAutomation.SheetStore.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:SheetStoreViewModel}"
             mc:Ignorable="d"
             Background="#F1F5F9">

    <UserControl.Resources>
        <conv:NullToBoolConverter x:Key="NullToBool"/>
        <conv:ColorNameToBrushConverter x:Key="ColorToBrush"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="FilterLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1E40AF"/>
            <Setter Property="Margin" Value="2,0,0,3"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= HEADER ================= -->
        <Border Grid.Row="0"
                CornerRadius="10"
                Padding="14,10"
                Margin="0,0,0,8"
                BorderBrush="#1E40AF"
                BorderThickness="1.5">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#1E40AF" Offset="0"/>
                    <GradientStop Color="#3B82F6" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border Background="#DBEAFE"
                            CornerRadius="6"
                            Padding="6,4"
                            Margin="0,0,8,0">
                        <TextBlock Text="📦" FontSize="14"/>
                    </Border>

                    <TextBlock Text="SHEET STORE"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="White"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <Button Content="✚ Add"
                            Background="#059669"
                            Foreground="White"
                            Padding="10,5"
                            FontSize="10"
                            FontWeight="SemiBold"
                            Margin="0,0,4,0"
                            Command="{Binding AddSheetCommand}"/>

                    <Button Content="📥 Import"
                            Background="#64748B"
                            Foreground="White"
                            Padding="10,5"
                            FontSize="10"
                            FontWeight="SemiBold"
                            Margin="0,0,4,0"
                            Command="{Binding ImportCommand}"/>

                    <Button Content="📤 Export"
                            Background="#64748B"
                            Foreground="White"
                            Padding="10,5"
                            FontSize="10"
                            FontWeight="SemiBold"
                            Margin="0,0,4,0"
                            Command="{Binding ExportCommand}"/>

                    <Button Content="🔄"
                            Background="#64748B"
                            Foreground="White"
                            Padding="8,5"
                            FontSize="10"
                            Command="{Binding RefreshCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= FILTERS ================= -->
        <Border Grid.Row="1"
                CornerRadius="10"
                Padding="10,8"
                Margin="0,0,0,8"
                BorderBrush="#3B82F6"
                BorderThickness="1"
                Background="White">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                    <TextBlock Text="CATEGORY" Style="{StaticResource FilterLabel}"/>
                    <ComboBox ItemsSource="{Binding Categories}"
                              SelectedItem="{Binding SelectedCategory}"
                              Padding="4,3"
                              FontSize="10"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,6,0">
                    <TextBlock Text="THICK" Style="{StaticResource FilterLabel}"/>
                    <ComboBox ItemsSource="{Binding Thicknesses}"
                              SelectedItem="{Binding SelectedThickness}"
                              Padding="4,3"
                              FontSize="10"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,6,0">
                    <TextBlock Text="COLOR" Style="{StaticResource FilterLabel}"/>
                    <ComboBox ItemsSource="{Binding Colors}"
                              SelectedItem="{Binding SelectedColor}"
                              Padding="4,3"
                              FontSize="10"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Margin="0,0,6,0">
                    <TextBlock Text="SUPPLIER" Style="{StaticResource FilterLabel}"/>
                    <ComboBox ItemsSource="{Binding Suppliers}"
                              SelectedItem="{Binding SelectedSupplier}"
                              Padding="4,3"
                              FontSize="10"/>
                </StackPanel>

                <StackPanel Grid.Column="4" Margin="0,0,6,0">
                    <TextBlock Text="SORT" Style="{StaticResource FilterLabel}"/>
                    <ComboBox ItemsSource="{Binding SortOptions}"
                              SelectedItem="{Binding SelectedSortOption}"
                              Padding="4,3"
                              FontSize="10"/>
                </StackPanel>

                <StackPanel Grid.Column="5" Margin="0,0,6,0">
                    <TextBlock Text="SEARCH" Style="{StaticResource FilterLabel}"/>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Padding="4,3"
                             FontSize="10"/>
                </StackPanel>

                <Button Grid.Column="6"
                        Content="Clear"
                        Background="#DC2626"
                        Foreground="White"
                        Padding="10,3"
                        FontSize="9"
                        VerticalAlignment="Bottom"
                        Command="{Binding ClearFilterCommand}"/>
            </Grid>
        </Border>

        <!-- ================= DATA GRID ================= -->
        <Border Grid.Row="2"
                CornerRadius="10"
                BorderBrush="#CBD5E1"
                BorderThickness="1"
                Background="White">

            <DataGrid ItemsSource="{Binding FilteredSheets}"
                      SelectedItem="{Binding SelectedSheet, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      RowHeight="30"
                      ColumnHeaderHeight="34"
                      FontSize="10"
                      GridLinesVisibility="Horizontal"
                      AlternatingRowBackground="#F8FAFC">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="#" Binding="{Binding SrNo}" Width="34"/>

                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="120"/>
                    <DataGridTextColumn Header="Thick" Binding="{Binding Thickness}" Width="65"/>

                    <DataGridTemplateColumn Header="Color" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center">
                                    <Border Width="11"
                                            Height="11"
                                            CornerRadius="2"
                                            Margin="0,0,5,0"
                                            Background="{Binding Color, Converter={StaticResource ColorToBrush}}"
                                            BorderBrush="#94A3B8"
                                            BorderThickness="1"/>
                                    <TextBlock Text="{Binding Color}"
                                               FontSize="10"
                                               Foreground="#7C3AED"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="W×H" Width="80">
                        <DataGridTextColumn.Binding>
                            <MultiBinding StringFormat="{}{0:0}×{1:0}">
                                <Binding Path="Width"/>
                                <Binding Path="Height"/>
                            </MultiBinding>
                        </DataGridTextColumn.Binding>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="SQM" Binding="{Binding SquareMeter, StringFormat=N2}" Width="55"/>
                    <DataGridTextColumn Header="Stock" Binding="{Binding TotalStock}" Width="55"/>
                    <DataGridTextColumn Header="Used" Binding="{Binding UsedSheets}" Width="55"/>
                    <DataGridTextColumn Header="Bal" Binding="{Binding BalanceSheets}" Width="55"/>
                    <DataGridTextColumn Header="Buy" Binding="{Binding PurchasePrice, StringFormat=N2}" Width="65"/>
                    <DataGridTextColumn Header="Sell" Binding="{Binding SellPrice, StringFormat=N2}" Width="65"/>

                    <DataGridTemplateColumn Header="Actions" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center">
                                    <Button Content="Buy"
                                            Command="{Binding DataContext.BuySheetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Padding="6,2"
                                            Margin="1,0"/>
                                    <Button Content="Use"
                                            Command="{Binding DataContext.UseSheetsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Padding="6,2"
                                            Margin="1,0"/>
                                    <Button Content="✎"
                                            Command="{Binding DataContext.EditSheetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Padding="5,2"
                                            Margin="1,0"/>
                                    <Button Content="✕"
                                            Command="{Binding DataContext.DeleteSheetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Padding="5,2"
                                            Margin="1,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ================= STATUS ================= -->
        <Border Grid.Row="3"
                CornerRadius="8"
                Padding="10,6"
                Margin="0,8,0,0"
                Background="White"
                BorderBrush="#CBD5E1"
                BorderThickness="1">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding StatusMessage}"
                           VerticalAlignment="Center"
                           FontSize="10"
                           Foreground="#475569"/>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="Value: "
                               FontSize="10"/>
                    <TextBlock Text="{Binding FilteredStats.TotalSellValue, StringFormat=N0}"
                               FontWeight="Bold"
                               Margin="4,0"/>
                    <TextBlock Text="AED"
                               FontSize="9"/>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</UserControl>
