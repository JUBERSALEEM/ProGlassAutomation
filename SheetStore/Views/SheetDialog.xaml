<Window x:Class="ProGlassAutomation.SheetStore.Views.SheetDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Height="500" Width="450"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Category" FontWeight="SemiBold" Margin="0,6,0,4"/>
            <ComboBox Text="{Binding Category}" ItemsSource="{Binding Categories}" Padding="6,4"/>

            <TextBlock Text="Thickness" FontWeight="SemiBold" Margin="0,6,0,4"/>
            <ComboBox Text="{Binding Thickness}" ItemsSource="{Binding Thicknesses}" Padding="6,4"/>

            <TextBlock Text="Color" FontWeight="SemiBold" Margin="0,6,0,4"/>
            <ComboBox Text="{Binding Color}" ItemsSource="{Binding Colors}" Padding="6,4">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Width="10" Height="10" Margin="0,0,6,0" Fill="{Binding Hex}"/>
                            <TextBlock Text="{Binding Name}"/>
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,6,4,0">
                    <TextBlock Text="Width (cm)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding Width, UpdateSourceTrigger=PropertyChanged}" Padding="6,4"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="4,6,0,0">
                    <TextBlock Text="Height (cm)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding Height, UpdateSourceTrigger=PropertyChanged}" Padding="6,4"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="Supplier" FontWeight="SemiBold" Margin="0,6,0,4"/>
            <ComboBox Text="{Binding Supplier}" ItemsSource="{Binding Suppliers}" Padding="6,4"/>

            <TextBlock Text="Description" FontWeight="SemiBold" Margin="0,6,0,4"/>
            <TextBox Text="{Binding Description}" Padding="6,4" AcceptsReturn="True" Height="40"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,6,4,0">
                    <TextBlock Text="Purchase Price" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding PurchasePrice, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" Padding="6,4"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="4,6,4,0">
                    <TextBlock Text="Sell Price" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding SellPrice, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" Padding="6,4"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="4,6,0,0">
                    <TextBlock Text="Initial Stock" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding InitialStock, UpdateSourceTrigger=PropertyChanged}" Padding="6,4"/>
                </StackPanel>
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Padding="16,8" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="Save" Padding="16,8" Background="#059669" Foreground="White" FontWeight="Bold" Click="Save_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>