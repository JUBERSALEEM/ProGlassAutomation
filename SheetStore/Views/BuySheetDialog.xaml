<Window x:Class="ProGlassAutomation.SheetStore.Views.BuySheetDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Buy Sheet" Height="380" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <Border Background="#DBEAFE" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                <TextBlock Text="{Binding SheetInfo}" FontWeight="Bold" Foreground="#1E40AF"/>
            </Border>

            <TextBlock Text="Quantity" FontWeight="SemiBold" Margin="0,6,0,4"/>
            <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Padding="6,4"/>

            <TextBlock Text="Unit Price (AED)" FontWeight="SemiBold" Margin="0,6,0,4"/>
            <TextBox Text="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" Padding="6,4"/>

            <Border Background="#F0FDF4" CornerRadius="6" Padding="10,6" Margin="0,12,0,0"
                    BorderBrush="#22C55E" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Total Cost: " FontWeight="SemiBold" Foreground="#15803D"/>
                    <TextBlock Text="{Binding TotalCost, StringFormat=N2}" FontWeight="Bold" FontSize="16" Foreground="#16A34A"/>
                    <TextBlock Text=" AED" Foreground="#15803D"/>
                </StackPanel>
            </Border>

            <TextBlock Text="Supplier" FontWeight="SemiBold" Margin="0,12,0,4"/>
            <TextBox Text="{Binding Supplier}" Padding="6,4"/>

            <TextBlock Text="Purchase Date" FontWeight="SemiBold" Margin="0,6,0,4"/>
            <DatePicker SelectedDate="{Binding PurchasedOn}"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Padding="16,8" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="Confirm Purchase" Padding="16,8" Background="#059669"
                    Foreground="White" FontWeight="Bold" Click="Confirm_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>