<Window x:Class="ProGlassAutomation.SheetStore.Views.PriceHistoryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Price History" Height="400" Width="500"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBox Grid.Row="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                 Padding="8" Margin="0,0,0,8" FontSize="12"/>

        <ListBox Grid.Row="1" ItemsSource="{Binding FilteredSheets}" DisplayMemberPath="Category" FontSize="11"/>
    </Grid>
</Window>