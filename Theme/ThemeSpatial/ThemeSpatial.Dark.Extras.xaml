  <SolidColorBrush x:Key="SpatialTintFeature" Color="#33B8A8F0" />
  <SolidColorBrush x:Key="SpatialStrokeFeature" Color="#66B8A8F0" />
  <SolidColorBrush x:Key="SpatialTintInformation" Color="#337EB8E8" />
