<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=mscorlib">
  <!-- Frost faces are translucent. Wallpaper is GlassCanvasBrush. Not Liquid veil, not Fluent mica. -->
  <SolidColorBrush x:Key="GlassFrostBrush" Color="#66F5FAFF" />
  <SolidColorBrush x:Key="GlassFrostSecondary" Color="#4DF5FAFF" />
  <SolidColorBrush x:Key="GlassFrostElevated" Color="#80F5FAFF" />
  <SolidColorBrush x:Key="GlassFrostInset" Color="#40F5FAFF" />
  <SolidColorBrush x:Key="GlassFrostControl" Color="#59F5FAFF" />
  <LinearGradientBrush x:Key="GlassHighlightBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#CCFFFFFF" Offset="0" />
    <GradientStop Color="#00FFFFFF" Offset="1" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="GlassHairlineBrush" Color="#CCFFFFFF" />
  <SolidColorBrush x:Key="GlassStrokeBrush" Color="#73FFFFFF" />
  <SolidColorBrush x:Key="GlassOpaqueBrush" Color="#F3F8FC" />
  <SolidColorBrush x:Key="GlassTintPositive" Color="#66165A3A" />
  <SolidColorBrush x:Key="GlassStrokePositive" Color="#99165A3A" />
  <SolidColorBrush x:Key="GlassTintFeature" Color="#665A3E90" />
  <SolidColorBrush x:Key="GlassStrokeFeature" Color="#995A3E90" />
  <SolidColorBrush x:Key="GlassTintInformation" Color="#661A4E90" />
  <SolidColorBrush x:Key="GlassStrokeInformation" Color="#991A4E90" />
  <SolidColorBrush x:Key="GlassTintAttention" Color="#667A4300" />
  <SolidColorBrush x:Key="GlassStrokeAttention" Color="#997A4300" />
  <SolidColorBrush x:Key="GlassTintAccent" Color="#66165A86" />
  <SolidColorBrush x:Key="GlassStrokeAccent" Color="#99165A86" />
  <SolidColorBrush x:Key="GlassTintHero" Color="#99165A86" />
  <SolidColorBrush x:Key="GlassStrokeHero" Color="#B3FFFFFF" />
  <SolidColorBrush x:Key="GlassRevealBrush" Color="#E6FFFFFF" />
  <SolidColorBrush x:Key="GlassRevealStroke" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="GlassShadowCasterBrush" Color="#140E1C2A" />
  <Color x:Key="GlassShadowColor">#3A5064</Color>
  <sys:Double x:Key="GlassLiftBlur">22</sys:Double>
  <sys:Double x:Key="GlassLiftDepth">6</sys:Double>
  <sys:Double x:Key="GlassLiftOpacity">0.16</sys:Double>
  <sys:Double x:Key="GlassSheenHeight">10</sys:Double>
  <sys:Boolean x:Key="GlassReduceTransparency">False</sys:Boolean>
  <LinearGradientBrush x:Key="GlassCanvasBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#BAD6EC" Offset="0" />
    <GradientStop Color="#A8C4E4" Offset="0.35" />
    <GradientStop Color="#D2C6E8" Offset="0.7" />
    <GradientStop Color="#B0D4DC" Offset="1" />
  </LinearGradientBrush>
</ResourceDictionary>
