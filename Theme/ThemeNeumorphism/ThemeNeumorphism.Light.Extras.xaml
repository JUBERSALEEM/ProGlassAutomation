<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=mscorlib">
  <SolidColorBrush x:Key="NeumorphLightBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="NeumorphDarkBrush" Color="#B0BAC6" />
  <SolidColorBrush x:Key="NeumorphRimLightBrush" Color="#F8FBFF" />
  <SolidColorBrush x:Key="NeumorphRimShadeBrush" Color="#C5CED8" />
  <Color x:Key="NeumorphLightColor">#FFFFFF</Color>
  <Color x:Key="NeumorphDarkColor">#B0BAC6</Color>
  <sys:Double x:Key="NeumorphBlur">16</sys:Double>
  <sys:Double x:Key="NeumorphDistance">6</sys:Double>
  <sys:Double x:Key="NeumorphLiftDistance">9</sys:Double>
  <sys:Double x:Key="NeumorphDarkOpacity">0.4</sys:Double>
  <sys:Double x:Key="NeumorphLightOpacity">0.8</sys:Double>
  <Thickness x:Key="NeumorphGutter">8</Thickness>
  <LinearGradientBrush x:Key="NeumorphSheenBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#73FFFFFF" Offset="0" />
    <GradientStop Color="#14FFFFFF" Offset="0.45" />
    <GradientStop Color="#1A1B2430" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="NeumorphWellSheenBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#331B2430" Offset="0" />
    <GradientStop Color="#00000000" Offset="0.48" />
    <GradientStop Color="#40FFFFFF" Offset="1" />
  </LinearGradientBrush>
  <Thickness x:Key="NeumorphRimLightThickness">5,5,0,0</Thickness>
  <Thickness x:Key="NeumorphRimShadeThickness">0,0,5,5</Thickness>
  <Thickness x:Key="NeumorphInsetLightThickness">0,0,5,5</Thickness>
  <Thickness x:Key="NeumorphInsetShadeThickness">6,6,0,0</Thickness>
</ResourceDictionary>
