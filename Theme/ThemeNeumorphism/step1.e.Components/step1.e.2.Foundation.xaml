<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:neu="clr-namespace:ProGlassAutomation.ThemeNeumorphism">
 <Style x:Key="KeyboardFocus" TargetType="Control">
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Control">
   <Border Margin="{DynamicResource MarginFocus}" BorderBrush="{DynamicResource FocusIndicator}" BorderThickness="{DynamicResource FocusThickness}" CornerRadius="{DynamicResource ControlCornerRadius}" />
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="ThemedWindow" TargetType="Window">
  <Setter Property="Background" Value="{DynamicResource ApplicationBackground}" />
  <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  <Setter Property="FontWeight" Value="{DynamicResource FontWeightBody}" />
  <Setter Property="FontFamily" Value="{DynamicResource FontFamilyBody}" />
  <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
  <Setter Property="UseLayoutRounding" Value="True" />
  <Setter Property="SnapsToDevicePixels" Value="True" />
 </Style>
 <Style TargetType="TextBlock">
  <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  <Setter Property="FontWeight" Value="{DynamicResource FontWeightBody}" />
  <Setter Property="FontFamily" Value="{DynamicResource FontFamilyBody}" />
  <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
  <Setter Property="TextWrapping" Value="Wrap" />
 </Style>
 <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
  <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
  <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
 </Style>
 <Style x:Key="SectionHeading" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
  <Setter Property="FontSize" Value="{DynamicResource FontSizeSection}" />
  <Setter Property="FontWeight" Value="{DynamicResource FontWeightHeading}" />
  <Setter Property="Margin" Value="{DynamicResource MarginItem}" />
 </Style>
 <Style x:Key="PageHeading" TargetType="TextBlock" BasedOn="{StaticResource SectionHeading}">
  <Setter Property="FontSize" Value="{DynamicResource FontSizeDisplay}" />
 </Style>
 <Style TargetType="neu:NeumorphSurface">
  <Setter Property="Focusable" Value="False" />
  <Setter Property="SnapsToDevicePixels" Value="True" />
  <Setter Property="ClipToBounds" Value="False" />
  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  <Setter Property="VerticalContentAlignment" Value="Stretch" />
  <Setter Property="LightBrush" Value="{DynamicResource NeumorphLightBrush}" />
  <Setter Property="DarkBrush" Value="{DynamicResource NeumorphDarkBrush}" />
  <Setter Property="RimLightBrush" Value="{DynamicResource NeumorphRimLightBrush}" />
  <Setter Property="RimShadeBrush" Value="{DynamicResource NeumorphRimShadeBrush}" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="neu:NeumorphSurface">
   <Grid ClipToBounds="False">
    <Border x:Name="DarkFar" Background="{TemplateBinding DarkBrush}" Opacity="0.28" CornerRadius="{TemplateBinding CornerRadius}" Margin="8,8,0,0" IsHitTestVisible="False" />
    <Border x:Name="DarkMid" Background="{TemplateBinding DarkBrush}" Opacity="0.42" CornerRadius="{TemplateBinding CornerRadius}" Margin="5,5,1,1" IsHitTestVisible="False" />
    <Border x:Name="DarkNear" Background="{TemplateBinding DarkBrush}" Opacity="0.62" CornerRadius="{TemplateBinding CornerRadius}" Margin="3,3,2,2" IsHitTestVisible="False" />
    <Border x:Name="LightFar" Background="{TemplateBinding LightBrush}" Opacity="0.32" CornerRadius="{TemplateBinding CornerRadius}" Margin="0,0,8,8" IsHitTestVisible="False" />
    <Border x:Name="LightMid" Background="{TemplateBinding LightBrush}" Opacity="0.55" CornerRadius="{TemplateBinding CornerRadius}" Margin="1,1,5,5" IsHitTestVisible="False" />
    <Border x:Name="LightNear" Background="{TemplateBinding LightBrush}" Opacity="0.9" CornerRadius="{TemplateBinding CornerRadius}" Margin="2,2,3,3" IsHitTestVisible="False" />
    <Border x:Name="Face" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" Margin="5">
     <Grid>
      <Border x:Name="Sheen" Background="{DynamicResource NeumorphSheenBrush}" CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False" />
      <Border x:Name="RimShade" BorderBrush="{TemplateBinding RimShadeBrush}" BorderThickness="{DynamicResource NeumorphRimShadeThickness}" CornerRadius="{TemplateBinding CornerRadius}">
       <Border x:Name="RimLight" BorderBrush="{TemplateBinding RimLightBrush}" BorderThickness="{DynamicResource NeumorphRimLightThickness}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
       </Border>
      </Border>
     </Grid>
    </Border>
   </Grid>
   <ControlTemplate.Triggers>
    <Trigger Property="Rank" Value="Control">
     <Setter TargetName="DarkFar" Property="Visibility" Value="Collapsed" />
     <Setter TargetName="LightFar" Property="Visibility" Value="Collapsed" />
     <Setter TargetName="Face" Property="Margin" Value="3.5" />
    </Trigger>
    <Trigger Property="Rank" Value="Chip">
     <Setter TargetName="DarkFar" Property="Visibility" Value="Collapsed" />
     <Setter TargetName="LightFar" Property="Visibility" Value="Collapsed" />
     <Setter TargetName="DarkMid" Property="Visibility" Value="Collapsed" />
     <Setter TargetName="LightMid" Property="Visibility" Value="Collapsed" />
     <Setter TargetName="DarkNear" Property="Margin" Value="2,2,0,0" />
     <Setter TargetName="LightNear" Property="Margin" Value="0,0,2,2" />
     <Setter TargetName="Face" Property="Margin" Value="2" />
    </Trigger>
    <Trigger Property="Lifted" Value="True">
     <Setter TargetName="DarkFar" Property="Visibility" Value="Visible" />
     <Setter TargetName="LightFar" Property="Visibility" Value="Visible" />
     <Setter TargetName="DarkMid" Property="Visibility" Value="Visible" />
     <Setter TargetName="LightMid" Property="Visibility" Value="Visible" />
     <Setter TargetName="Face" Property="Margin" Value="6" />
    </Trigger>
    <Trigger Property="Concave" Value="True">
     <Setter TargetName="DarkFar" Property="Visibility" Value="Collapsed" />
     <Setter TargetName="DarkMid" Property="Visibility" Value="Collapsed" />
     <Setter TargetName="DarkNear" Property="Visibility" Value="Collapsed" />
     <Setter TargetName="LightFar" Property="Visibility" Value="Collapsed" />
     <Setter TargetName="LightMid" Property="Visibility" Value="Collapsed" />
     <Setter TargetName="LightNear" Property="Visibility" Value="Collapsed" />
     <Setter TargetName="Face" Property="Margin" Value="1" />
     <Setter TargetName="Sheen" Property="Background" Value="{DynamicResource NeumorphWellSheenBrush}" />
     <Setter TargetName="RimShade" Property="BorderThickness" Value="{DynamicResource NeumorphInsetShadeThickness}" />
     <Setter TargetName="RimLight" Property="BorderThickness" Value="{DynamicResource NeumorphInsetLightThickness}" />
    </Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="Card" TargetType="ContentControl">
  <Setter Property="Background" Value="{DynamicResource SurfacePrimary}" />
  <Setter Property="Padding" Value="{DynamicResource PaddingCard}" />
  <Setter Property="HorizontalAlignment" Value="Stretch" />
  <Setter Property="VerticalAlignment" Value="Stretch" />
  <Setter Property="Focusable" Value="False" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContentControl">
   <neu:NeumorphSurface Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="{DynamicResource CardCornerRadius}" Rank="Card">
    <ContentPresenter />
   </neu:NeumorphSurface>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="BentoTile" TargetType="ContentControl" BasedOn="{StaticResource Card}">
  <Setter Property="Margin" Value="0" />
 </Style>
 <Style x:Key="Plate" TargetType="ContentControl" BasedOn="{StaticResource Card}">
  <Setter Property="Background" Value="{DynamicResource SurfacePrimary}" />
  <Setter Property="Padding" Value="{DynamicResource PaddingPlate}" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContentControl">
   <neu:NeumorphSurface Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="{DynamicResource ControlCornerRadius}" Rank="Control">
    <ContentPresenter />
   </neu:NeumorphSurface>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="AccentPlate" TargetType="ContentControl" BasedOn="{StaticResource Plate}">
  <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
 </Style>
 <Style x:Key="ElevatedPlate" TargetType="ContentControl" BasedOn="{StaticResource Plate}">
  <Setter Property="Background" Value="{DynamicResource SurfacePrimary}" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContentControl">
   <neu:NeumorphSurface Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="{DynamicResource ControlCornerRadius}" Rank="Card">
    <ContentPresenter />
   </neu:NeumorphSurface>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="TokenValue" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
  <Setter Property="FontFamily" Value="{DynamicResource FontFamilyMono}" />
 </Style>
 <Style TargetType="Separator">
  <Setter Property="Margin" Value="{DynamicResource MarginItem}" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator">
   <neu:NeumorphSurface Height="{DynamicResource SpacingMedium}" Concave="True" Rank="Chip" Background="{DynamicResource SurfacePrimary}" CornerRadius="{DynamicResource ChipCornerRadius}" />
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="ProgressBar">
  <Setter Property="Height" Value="{DynamicResource SpacingLarge}" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar">
   <neu:NeumorphSurface Concave="True" Rank="Chip" Background="{DynamicResource SurfacePrimary}" CornerRadius="{DynamicResource ChipCornerRadius}">
    <Border x:Name="PART_Track">
     <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{DynamicResource AccentPrimary}" CornerRadius="{DynamicResource ChipCornerRadius}" />
    </Border>
   </neu:NeumorphSurface>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
</ResourceDictionary>
