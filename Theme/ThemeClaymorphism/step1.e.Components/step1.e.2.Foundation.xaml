<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:clay="clr-namespace:ProGlassAutomation.ThemeClaymorphism">
 <Style x:Key="KeyboardFocus" TargetType="Control">
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Control">
   <Border Margin="{DynamicResource MarginFocus}" BorderBrush="{DynamicResource FocusIndicator}" BorderThickness="{DynamicResource FocusThickness}" CornerRadius="{DynamicResource ControlCornerRadius}" />
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="ThemedWindow" TargetType="Window">
  <Setter Property="Background" Value="{DynamicResource ApplicationBackground}" />
  <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  <Setter Property="FontWeight" Value="{DynamicResource FontWeightBody}" />
  <Setter Property="FontFamily" Value="{DynamicResource FontFamilyBody}" />
  <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
  <Setter Property="UseLayoutRounding" Value="True" />
  <Setter Property="SnapsToDevicePixels" Value="True" />
 </Style>
 <Style TargetType="TextBlock">
  <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  <Setter Property="FontWeight" Value="{DynamicResource FontWeightBody}" />
  <Setter Property="FontFamily" Value="{DynamicResource FontFamilyBody}" />
  <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
  <Setter Property="TextWrapping" Value="Wrap" />
 </Style>
 <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
  <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
  <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
 </Style>
 <Style x:Key="SectionHeading" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
  <Setter Property="FontSize" Value="{DynamicResource FontSizeSection}" />
  <Setter Property="FontWeight" Value="{DynamicResource FontWeightHeading}" />
  <Setter Property="Margin" Value="{DynamicResource MarginItem}" />
 </Style>
 <Style x:Key="PageHeading" TargetType="TextBlock" BasedOn="{StaticResource SectionHeading}">
  <Setter Property="FontSize" Value="{DynamicResource FontSizeDisplay}" />
 </Style>
 <Style TargetType="clay:ClaySurface">
  <Setter Property="Focusable" Value="False" />
  <Setter Property="SnapsToDevicePixels" Value="True" />
  <Setter Property="ClipToBounds" Value="False" />
  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  <Setter Property="VerticalContentAlignment" Value="Stretch" />
  <Setter Property="ShowDrop" Value="{DynamicResource ClayShowDrop}" />
  <Setter Property="DropBrush" Value="{DynamicResource ClayDropBrush}" />
  <Setter Property="ShadeBrush" Value="{DynamicResource ClayInsetShadeBrush}" />
  <Setter Property="LightBrush" Value="{DynamicResource ClayInsetLightBrush}" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="clay:ClaySurface">
   <Grid ClipToBounds="False">
    <Grid x:Name="Volume" Margin="{DynamicResource ClayGutter}" ClipToBounds="False">
     <Border x:Name="DarkGlow" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False">
      <Border.Effect>
       <DropShadowEffect Color="{DynamicResource ClayShadowColor}" BlurRadius="{DynamicResource ClayBlur}" ShadowDepth="{DynamicResource ClayDistance}" Direction="315" Opacity="{DynamicResource ClayDarkGlowOpacity}" RenderingBias="Quality" />
      </Border.Effect>
     </Border>
     <Border x:Name="LightGlow" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False">
      <Border.Effect>
       <DropShadowEffect Color="{DynamicResource ClayHighlightColor}" BlurRadius="{DynamicResource ClayBlur}" ShadowDepth="{DynamicResource ClayDistance}" Direction="135" Opacity="{DynamicResource ClayLightGlowOpacity}" RenderingBias="Quality" />
      </Border.Effect>
     </Border>
     <Border x:Name="DarkGlowControl" Visibility="Collapsed" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False">
      <Border.Effect>
       <DropShadowEffect Color="{DynamicResource ClayShadowColor}" BlurRadius="10" ShadowDepth="{DynamicResource ClayDistance}" Direction="315" Opacity="{DynamicResource ClayDarkGlowOpacity}" RenderingBias="Quality" />
      </Border.Effect>
     </Border>
     <Border x:Name="LightGlowControl" Visibility="Collapsed" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False">
      <Border.Effect>
       <DropShadowEffect Color="{DynamicResource ClayHighlightColor}" BlurRadius="10" ShadowDepth="{DynamicResource ClayDistance}" Direction="135" Opacity="{DynamicResource ClayLightGlowOpacity}" RenderingBias="Quality" />
      </Border.Effect>
     </Border>
     <Border x:Name="DarkGlowChip" Visibility="Collapsed" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False">
      <Border.Effect>
       <DropShadowEffect Color="{DynamicResource ClayShadowColor}" BlurRadius="7" ShadowDepth="3" Direction="315" Opacity="{DynamicResource ClayDarkGlowOpacity}" RenderingBias="Quality" />
      </Border.Effect>
     </Border>
     <Border x:Name="LightGlowChip" Visibility="Collapsed" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False">
      <Border.Effect>
       <DropShadowEffect Color="{DynamicResource ClayHighlightColor}" BlurRadius="7" ShadowDepth="3" Direction="135" Opacity="{DynamicResource ClayLightGlowOpacity}" RenderingBias="Quality" />
      </Border.Effect>
     </Border>
     <Border x:Name="DarkGlowLift" Visibility="Collapsed" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False">
      <Border.Effect>
       <DropShadowEffect Color="{DynamicResource ClayShadowColor}" BlurRadius="{DynamicResource ClayBlur}" ShadowDepth="{DynamicResource ClayLiftDistance}" Direction="315" Opacity="{DynamicResource ClayDarkGlowOpacity}" RenderingBias="Quality" />
      </Border.Effect>
     </Border>
     <Border x:Name="LightGlowLift" Visibility="Collapsed" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False">
      <Border.Effect>
       <DropShadowEffect Color="{DynamicResource ClayHighlightColor}" BlurRadius="{DynamicResource ClayBlur}" ShadowDepth="{DynamicResource ClayLiftDistance}" Direction="135" Opacity="{DynamicResource ClayLightGlowOpacity}" RenderingBias="Quality" />
      </Border.Effect>
     </Border>
     <Border x:Name="Face" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" Margin="{DynamicResource ClayFaceMargin}">
      <Grid>
       <Border x:Name="Curve" Background="{DynamicResource ClayCurveBrush}" CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False" />
       <Border x:Name="InnerShade" BorderBrush="{TemplateBinding ShadeBrush}" BorderThickness="{DynamicResource ClayShadeThickness}" CornerRadius="{TemplateBinding CornerRadius}">
        <Border x:Name="InnerLight" BorderBrush="{TemplateBinding LightBrush}" BorderThickness="{DynamicResource ClayLightThickness}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
         <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Border>
       </Border>
      </Grid>
     </Border>
    </Grid>
   </Grid>
   <ControlTemplate.Triggers>
    <Trigger Property="Rank" Value="Control">
     <Setter TargetName="Volume" Property="Margin" Value="8" />
     <Setter TargetName="DarkGlow" Property="Visibility" Value="Collapsed" />
     <Setter TargetName="LightGlow" Property="Visibility" Value="Collapsed" />
     <Setter TargetName="DarkGlowControl" Property="Visibility" Value="Visible" />
     <Setter TargetName="LightGlowControl" Property="Visibility" Value="Visible" />
    </Trigger>
    <Trigger Property="Rank" Value="Chip">
     <Setter TargetName="Volume" Property="Margin" Value="4" />
     <Setter TargetName="DarkGlow" Property="Visibility" Value="Collapsed" />
     <Setter TargetName="LightGlow" Property="Visibility" Value="Collapsed" />
     <Setter TargetName="DarkGlowChip" Property="Visibility" Value="Visible" />
     <Setter TargetName="LightGlowChip" Property="Visibility" Value="Visible" />
    </Trigger>
    <Trigger Property="Lifted" Value="True">
     <Setter TargetName="DarkGlow" Property="Visibility" Value="Collapsed" />
     <Setter TargetName="LightGlow" Property="Visibility" Value="Collapsed" />
     <Setter TargetName="DarkGlowControl" Property="Visibility" Value="Collapsed" />
     <Setter TargetName="LightGlowControl" Property="Visibility" Value="Collapsed" />
     <Setter TargetName="DarkGlowChip" Property="Visibility" Value="Collapsed" />
     <Setter TargetName="LightGlowChip" Property="Visibility" Value="Collapsed" />
     <Setter TargetName="DarkGlowLift" Property="Visibility" Value="Visible" />
     <Setter TargetName="LightGlowLift" Property="Visibility" Value="Visible" />
    </Trigger>
    <Trigger Property="ShowDrop" Value="False">
     <Setter TargetName="DarkGlow" Property="Visibility" Value="Collapsed" />
     <Setter TargetName="LightGlow" Property="Visibility" Value="Collapsed" />
     <Setter TargetName="DarkGlowControl" Property="Visibility" Value="Collapsed" />
     <Setter TargetName="LightGlowControl" Property="Visibility" Value="Collapsed" />
     <Setter TargetName="DarkGlowChip" Property="Visibility" Value="Collapsed" />
     <Setter TargetName="LightGlowChip" Property="Visibility" Value="Collapsed" />
     <Setter TargetName="DarkGlowLift" Property="Visibility" Value="Collapsed" />
     <Setter TargetName="LightGlowLift" Property="Visibility" Value="Collapsed" />
     <Setter TargetName="Volume" Property="Margin" Value="0" />
     <Setter TargetName="Face" Property="Margin" Value="0" />
    </Trigger>
    <Trigger Property="Concave" Value="True">
     <Setter TargetName="DarkGlow" Property="Visibility" Value="Collapsed" />
     <Setter TargetName="LightGlow" Property="Visibility" Value="Collapsed" />
     <Setter TargetName="DarkGlowControl" Property="Visibility" Value="Collapsed" />
     <Setter TargetName="LightGlowControl" Property="Visibility" Value="Collapsed" />
     <Setter TargetName="DarkGlowChip" Property="Visibility" Value="Collapsed" />
     <Setter TargetName="LightGlowChip" Property="Visibility" Value="Collapsed" />
     <Setter TargetName="DarkGlowLift" Property="Visibility" Value="Collapsed" />
     <Setter TargetName="LightGlowLift" Property="Visibility" Value="Collapsed" />
     <Setter TargetName="Volume" Property="Margin" Value="2" />
     <Setter TargetName="Face" Property="Margin" Value="1" />
     <Setter TargetName="Curve" Property="Background" Value="{DynamicResource ClayWellCurveBrush}" />
     <Setter TargetName="InnerShade" Property="BorderThickness" Value="{DynamicResource ClayWellShadeThickness}" />
     <Setter TargetName="InnerLight" Property="BorderThickness" Value="{DynamicResource ClayWellLightThickness}" />
    </Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="Card" TargetType="ContentControl">
  <Setter Property="Background" Value="{DynamicResource SurfacePrimary}" />
  <Setter Property="Padding" Value="{DynamicResource PaddingCard}" />
  <Setter Property="HorizontalAlignment" Value="Stretch" />
  <Setter Property="VerticalAlignment" Value="Stretch" />
  <Setter Property="Focusable" Value="False" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContentControl">
   <clay:ClaySurface Rank="Card" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="{DynamicResource CardCornerRadius}" DropBrush="{DynamicResource ClayDropBrush}" ShadeBrush="{DynamicResource ClayInsetShadeBrush}" LightBrush="{DynamicResource ClayInsetLightBrush}">
    <ContentPresenter />
   </clay:ClaySurface>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="BentoTile" TargetType="ContentControl" BasedOn="{StaticResource Card}">
  <Setter Property="Margin" Value="0" />
 </Style>
 <Style x:Key="Plate" TargetType="ContentControl" BasedOn="{StaticResource Card}">
  <Setter Property="Background" Value="{DynamicResource SurfacePrimary}" />
  <Setter Property="Padding" Value="{DynamicResource PaddingPlate}" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContentControl">
   <clay:ClaySurface Rank="Control" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="{DynamicResource ControlCornerRadius}" DropBrush="{DynamicResource ClayDropBrush}" ShadeBrush="{DynamicResource ClayInsetShadeBrush}" LightBrush="{DynamicResource ClayInsetLightBrush}">
    <ContentPresenter />
   </clay:ClaySurface>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="AccentPlate" TargetType="ContentControl" BasedOn="{StaticResource Plate}">
  <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContentControl">
   <clay:ClaySurface Rank="Control" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="{DynamicResource ControlCornerRadius}" DropBrush="{DynamicResource ClayDropAccent}" ShadeBrush="{DynamicResource ClayShadeAccent}" LightBrush="{DynamicResource ClayInsetLightBrush}">
    <ContentPresenter />
   </clay:ClaySurface>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="ElevatedPlate" TargetType="ContentControl" BasedOn="{StaticResource Plate}">
  <Setter Property="Background" Value="{DynamicResource SurfacePrimary}" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContentControl">
   <clay:ClaySurface Rank="Card" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="{DynamicResource ControlCornerRadius}" DropBrush="{DynamicResource ClayDropBrush}" ShadeBrush="{DynamicResource ClayInsetShadeBrush}" LightBrush="{DynamicResource ClayInsetLightBrush}">
    <ContentPresenter />
   </clay:ClaySurface>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="TokenValue" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
  <Setter Property="FontFamily" Value="{DynamicResource FontFamilyMono}" />
 </Style>
 <Style TargetType="Separator">
  <Setter Property="Margin" Value="{DynamicResource MarginItem}" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator">
   <clay:ClaySurface Height="{DynamicResource SpacingMedium}" Concave="True" Rank="Chip" Background="{DynamicResource SurfaceSecondary}" CornerRadius="{DynamicResource ChipCornerRadius}" />
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="ProgressBar">
  <Setter Property="Height" Value="{DynamicResource SpacingLarge}" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar">
   <clay:ClaySurface Concave="True" Rank="Chip" Background="{DynamicResource SurfaceSecondary}" CornerRadius="{DynamicResource ChipCornerRadius}">
    <Border x:Name="PART_Track">
     <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{DynamicResource AccentPrimary}" CornerRadius="{DynamicResource ChipCornerRadius}" />
    </Border>
   </clay:ClaySurface>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
</ResourceDictionary>
