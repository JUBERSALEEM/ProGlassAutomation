<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:clay="clr-namespace:ProGlassAutomation.ThemeClaymorphism">
 <Style TargetType="CheckBox">
  <Setter Property="FocusVisualStyle" Value="{DynamicResource KeyboardFocus}" />
  <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
  <Setter Property="MinHeight" Value="{DynamicResource ControlMinHeight}" />
  <Setter Property="Padding" Value="{DynamicResource PaddingChoice}" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
   <Border x:Name="Frame" Background="{DynamicResource TransparentBrush}" BorderBrush="{DynamicResource TransparentBrush}" BorderThickness="{DynamicResource BorderThicknessControl}" CornerRadius="{DynamicResource ControlCornerRadius}" Padding="{TemplateBinding Padding}">
    <DockPanel>
     <Grid DockPanel.Dock="Left" Width="{DynamicResource ChoiceMarkSize}" Height="{DynamicResource ChoiceMarkSize}" VerticalAlignment="Center">
      <Border Background="{DynamicResource ClayDropBrush}" CornerRadius="{DynamicResource ChipCornerRadius}" Margin="2,2,0,0" />
      <Border x:Name="Indicator" BorderBrush="{DynamicResource ClayInsetLightBrush}" BorderThickness="1,1,0,0" CornerRadius="{DynamicResource ChipCornerRadius}" Background="{DynamicResource SurfacePrimary}" Margin="0,0,2,2"><Path x:Name="Mark" Data="M 2,8 L 6,12 L 14,3" Stroke="{DynamicResource TextOnAccent}" StrokeThickness="{DynamicResource StrokeWidth}" Stretch="Uniform" Margin="{DynamicResource PaddingMark}" Visibility="Collapsed" /></Border>
     </Grid>
     <ContentPresenter Margin="{DynamicResource PaddingChoice}" VerticalAlignment="Center" RecognizesAccessKey="True" />
    </DockPanel>
   </Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource StateHover}" /></Trigger>
    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Mark" Property="Visibility" Value="Visible" /><Setter TargetName="Indicator" Property="Background" Value="{DynamicResource AccentPrimary}" /><Setter TargetName="Frame" Property="Background" Value="{DynamicResource StateSelected}" /></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource FocusIndicator}" /><Setter TargetName="Frame" Property="BorderThickness" Value="{DynamicResource FocusThickness}" /></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="{DynamicResource DisabledOpacity}" /></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="RadioButton">
  <Setter Property="FocusVisualStyle" Value="{DynamicResource KeyboardFocus}" />
  <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
  <Setter Property="MinHeight" Value="{DynamicResource ControlMinHeight}" />
  <Setter Property="Padding" Value="{DynamicResource PaddingChoice}" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
   <Border x:Name="Frame" Background="{DynamicResource TransparentBrush}" BorderBrush="{DynamicResource TransparentBrush}" BorderThickness="{DynamicResource BorderThicknessControl}" CornerRadius="{DynamicResource ControlCornerRadius}" Padding="{TemplateBinding Padding}">
    <DockPanel>
     <Grid DockPanel.Dock="Left" Width="{DynamicResource ChoiceMarkSize}" Height="{DynamicResource ChoiceMarkSize}" VerticalAlignment="Center">
      <Border Background="{DynamicResource ClayDropBrush}" CornerRadius="{DynamicResource ChoiceCornerRadius}" Margin="2,2,0,0" />
      <Border x:Name="Indicator" BorderBrush="{DynamicResource ClayInsetLightBrush}" BorderThickness="1,1,0,0" CornerRadius="{DynamicResource ChoiceCornerRadius}" Background="{DynamicResource SurfacePrimary}" Margin="0,0,2,2"><Ellipse x:Name="Mark" Fill="{DynamicResource TextOnAccent}" Margin="{DynamicResource PaddingMark}" Visibility="Collapsed" /></Border>
     </Grid>
     <ContentPresenter Margin="{DynamicResource PaddingChoice}" VerticalAlignment="Center" RecognizesAccessKey="True" />
    </DockPanel>
   </Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource StateHover}" /></Trigger>
    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Mark" Property="Visibility" Value="Visible" /><Setter TargetName="Indicator" Property="Background" Value="{DynamicResource AccentPrimary}" /><Setter TargetName="Frame" Property="Background" Value="{DynamicResource StateSelected}" /></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource FocusIndicator}" /><Setter TargetName="Frame" Property="BorderThickness" Value="{DynamicResource FocusThickness}" /></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="{DynamicResource DisabledOpacity}" /></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="ListBox">
  <Setter Property="Background" Value="{DynamicResource SurfacePrimary}" />
  <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
  <Setter Property="BorderThickness" Value="{DynamicResource BorderThicknessControl}" />
  <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBox">
   <clay:ClaySurface Concave="True" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource CardCornerRadius}">
    <ScrollViewer Focusable="False"><ItemsPresenter /></ScrollViewer>
   </clay:ClaySurface>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="ListBoxItem">
  <Setter Property="FocusVisualStyle" Value="{DynamicResource KeyboardFocus}" />
  <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  <Setter Property="Padding" Value="{DynamicResource PaddingControl}" />
  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
   <Border x:Name="Frame" Background="{DynamicResource TransparentBrush}" BorderBrush="{DynamicResource TransparentBrush}" BorderThickness="{DynamicResource BorderThicknessControl}" Padding="{TemplateBinding Padding}" CornerRadius="{DynamicResource ChipCornerRadius}"><ContentPresenter /></Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource StateHover}" /></Trigger>
    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource StateSelected}" /><Setter Property="Foreground" Value="{DynamicResource AccentPrimary}" /></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource FocusIndicator}" /></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource DisabledText}" /></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
</ResourceDictionary>
