<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=mscorlib">
  <sys:Boolean x:Key="ClayShowDrop">True</sys:Boolean>
  <Thickness x:Key="ClayDropMargin">3,4,0,0</Thickness>
  <Thickness x:Key="ClayDropFarMargin">6,8,0,0</Thickness>
  <Thickness x:Key="ClayFaceMargin">1</Thickness>
  <Thickness x:Key="ClayLiftMargin">0,0,3,4</Thickness>
  <Thickness x:Key="ClayLiftDropMargin">5,7,0,0</Thickness>
  <Thickness x:Key="ClayLiftFaceMargin">0,0,4,5</Thickness>
  <Thickness x:Key="ClayShadeThickness">0,0,2.5,2.5</Thickness>
  <Thickness x:Key="ClayLightThickness">2.5,2.5,0,0</Thickness>
  <Thickness x:Key="ClayWellShadeThickness">4,4,0,0</Thickness>
  <Thickness x:Key="ClayWellLightThickness">0,0,3,3</Thickness>
  <Thickness x:Key="ClayGutter">10</Thickness>
  <sys:Double x:Key="ClayBlur">14</sys:Double>
  <sys:Double x:Key="ClayDistance">5</sys:Double>
  <sys:Double x:Key="ClayLiftDistance">8</sys:Double>
  <sys:Double x:Key="ClayDarkGlowOpacity">0.55</sys:Double>
  <sys:Double x:Key="ClayLightGlowOpacity">0.42</sys:Double>
  <Color x:Key="ClayShadowColor">#140E0C</Color>
  <Color x:Key="ClayHighlightColor">#C4A990</Color>
  <SolidColorBrush x:Key="ClayDropBrush" Color="#99140E0C" />
  <SolidColorBrush x:Key="ClayLiftBrush" Color="#44FFFFFF" />
  <SolidColorBrush x:Key="ClayInsetLightBrush" Color="#66FFFFFF" />
  <SolidColorBrush x:Key="ClayInsetShadeBrush" Color="#88000000" />
  <LinearGradientBrush x:Key="ClayCurveBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#40FFFFFF" Offset="0" />
    <GradientStop Color="#12FFFFFF" Offset="0.4" />
    <GradientStop Color="#44000000" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="ClayWellCurveBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#66000000" Offset="0" />
    <GradientStop Color="#00000000" Offset="0.45" />
    <GradientStop Color="#33FFFFFF" Offset="1" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="ClayDropPositive" Color="#991A3A30" />
  <SolidColorBrush x:Key="ClayShadePositive" Color="#661A3A30" />
  <SolidColorBrush x:Key="ClayDropFeature" Color="#992E2450" />
  <SolidColorBrush x:Key="ClayShadeFeature" Color="#662E2450" />
  <SolidColorBrush x:Key="ClayDropInformation" Color="#991E2A48" />
  <SolidColorBrush x:Key="ClayShadeInformation" Color="#661E2A48" />
  <SolidColorBrush x:Key="ClayDropAttention" Color="#993A2A20" />
  <SolidColorBrush x:Key="ClayShadeAttention" Color="#663A2A20" />
  <SolidColorBrush x:Key="ClayDropAccent" Color="#99FF8A80" />
  <SolidColorBrush x:Key="ClayShadeAccent" Color="#66FF8A80" />
  <SolidColorBrush x:Key="ClayDropHero" Color="#99140E0C" />
  <SolidColorBrush x:Key="ClayShadeHero" Color="#66000000" />
</ResourceDictionary>
