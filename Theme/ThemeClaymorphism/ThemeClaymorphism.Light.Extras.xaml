<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=mscorlib">
  <sys:Boolean x:Key="ClayShowDrop">True</sys:Boolean>
  <Thickness x:Key="ClayDropMargin">3,4,0,0</Thickness>
  <Thickness x:Key="ClayDropFarMargin">6,8,0,0</Thickness>
  <Thickness x:Key="ClayFaceMargin">1</Thickness>
  <Thickness x:Key="ClayLiftMargin">0,0,3,4</Thickness>
  <Thickness x:Key="ClayLiftDropMargin">5,7,0,0</Thickness>
  <Thickness x:Key="ClayLiftFaceMargin">0,0,4,5</Thickness>
  <Thickness x:Key="ClayShadeThickness">0,0,2.5,2.5</Thickness>
  <Thickness x:Key="ClayLightThickness">2.5,2.5,0,0</Thickness>
  <Thickness x:Key="ClayWellShadeThickness">4,4,0,0</Thickness>
  <Thickness x:Key="ClayWellLightThickness">0,0,3,3</Thickness>
  <Thickness x:Key="ClayGutter">10</Thickness>
  <sys:Double x:Key="ClayBlur">14</sys:Double>
  <sys:Double x:Key="ClayDistance">5</sys:Double>
  <sys:Double x:Key="ClayLiftDistance">8</sys:Double>
  <sys:Double x:Key="ClayDarkGlowOpacity">0.38</sys:Double>
  <sys:Double x:Key="ClayLightGlowOpacity">0.72</sys:Double>
  <Color x:Key="ClayShadowColor">#A89CBC</Color>
  <Color x:Key="ClayHighlightColor">#FFFFFF</Color>
  <SolidColorBrush x:Key="ClayDropBrush" Color="#445B4A9A" />
  <SolidColorBrush x:Key="ClayLiftBrush" Color="#99FFFFFF" />
  <SolidColorBrush x:Key="ClayInsetLightBrush" Color="#F2FFFFFF" />
  <SolidColorBrush x:Key="ClayInsetShadeBrush" Color="#335B4A9A" />
  <LinearGradientBrush x:Key="ClayCurveBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#99FFFFFF" Offset="0" />
    <GradientStop Color="#22FFFFFF" Offset="0.38" />
    <GradientStop Color="#335B4A9A" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="ClayWellCurveBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#335B4A9A" Offset="0" />
    <GradientStop Color="#00000000" Offset="0.45" />
    <GradientStop Color="#33FFFFFF" Offset="1" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="ClayDropPositive" Color="#66146C45" />
  <SolidColorBrush x:Key="ClayShadePositive" Color="#33146C45" />
  <SolidColorBrush x:Key="ClayDropFeature" Color="#665B4A9A" />
  <SolidColorBrush x:Key="ClayShadeFeature" Color="#335B4A9A" />
  <SolidColorBrush x:Key="ClayDropInformation" Color="#662158A8" />
  <SolidColorBrush x:Key="ClayShadeInformation" Color="#332158A8" />
  <SolidColorBrush x:Key="ClayDropAttention" Color="#66C27A00" />
  <SolidColorBrush x:Key="ClayShadeAttention" Color="#33C27A00" />
  <SolidColorBrush x:Key="ClayDropAccent" Color="#66C81E1E" />
  <SolidColorBrush x:Key="ClayShadeAccent" Color="#33C81E1E" />
  <SolidColorBrush x:Key="ClayDropHero" Color="#445B4A9A" />
  <SolidColorBrush x:Key="ClayShadeHero" Color="#335B4A9A" />
</ResourceDictionary>
