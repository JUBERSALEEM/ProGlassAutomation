<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows7.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <!-- Explicit inclusion keeps unrelated, preserved repository source out of V3.0. -->
  <ItemGroup>
    <Compile Include="App.xaml.cs;MainWindow.xaml.cs;AssemblyInfo.cs" />
    <Compile Include="Theme/step1.a.ThemeEngine/**/*.cs;Theme/ThemeBento/**/*.cs;step1.ThemeStudio/step1.b.ThemeStudioScreen/**/*.cs" />
    <Page Include="MainWindow.xaml;Theme/ThemeBento/**/*.xaml;step1.ThemeStudio/step1.b.ThemeStudioScreen/**/*.xaml" />
  </ItemGroup>
</Project>
