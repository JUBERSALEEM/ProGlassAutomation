<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============== CONVERTERS & EFFECTS ============== -->
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    <DropShadowEffect x:Key="CardShadow" BlurRadius="12" ShadowDepth="2" Opacity="0.12" Color="#000000" Direction="270"/>

    <!-- ============== STYLES (must be defined BEFORE templates) ============== -->
    <Style x:Key="SidebarSubActionButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#475569"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="14,10"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}" 
                            Padding="{TemplateBinding Padding}" CornerRadius="8" Margin="1">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#EFF6FF"/>
                            <Setter Property="Foreground" Value="#2563EB"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CollapseArrowButtonStyle" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border CornerRadius="8" Background="{TemplateBinding Background}">
                        <TextBlock Text="◀◀" FontSize="11" FontWeight="Bold" Foreground="#64748B" 
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#F1F5F9"/>
                            <Setter Property="Foreground" Value="#2563EB"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ExpandArrowButtonStyle" TargetType="ToggleButton">
        <Setter Property="Background" Value="#2563EB"/>
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border CornerRadius="20" Background="{TemplateBinding Background}" 
                            BorderBrush="#FFFFFF" BorderThickness="1.5">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.25" Color="#000000"/>
                        </Border.Effect>
                        <TextBlock Text="▶▶" FontSize="10" FontWeight="Black" Foreground="White" 
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="1,0,0,0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#1D4ED8"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============== TEMPLATES (defined AFTER styles) ============== -->
    <ControlTemplate x:Key="CollapsibleSidebarTemplate" TargetType="ContentControl">
        <Border x:Name="SidebarBorder" 
                Background="#F8FAFC" 
                BorderBrush="#E2E8F0" 
                BorderThickness="0,0,1,0"
                Width="300">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Border Width="45" Height="38" CornerRadius="8" Background="White" Padding="3">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.1" Color="#000000"/>
                            </Border.Effect>
                            <TextBlock Text="ERP" FontSize="12" FontWeight="Bold" Foreground="#2563EB" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="ProGlass" FontSize="14" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock Text="Automation ERP" FontSize="8" Foreground="#94A3B8"/>
                        </StackPanel>
                    </StackPanel>

                    <ToggleButton x:Name="SidebarToggle" 
                                  Grid.Column="1" 
                                  Style="{StaticResource CollapseArrowButtonStyle}" 
                                  VerticalAlignment="Center"/>
                </Grid>

                <!-- Module List -->
                <StackPanel Grid.Row="1">
                    <TextBlock Text="MODULES" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,8"/>

                    <!-- Dashboard -->
                    <Border Background="#FFFFFF" CornerRadius="12" BorderBrush="#E2E8F0" 
                            BorderThickness="1" Margin="0,0,0,8" Padding="2" 
                            Effect="{StaticResource CardShadow}">
                        <Button x:Name="DashboardButton"
                                Style="{StaticResource SidebarSubActionButton}" 
                                Padding="12,10" HorizontalContentAlignment="Stretch">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="📊" Margin="0,0,10,0" FontSize="13"/>
                                <TextBlock Grid.Column="1" Text="Dashboard" FontSize="11" 
                                           FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                    </Border>

                    <!-- SheetStore -->
                    <Border Background="#FFFFFF" CornerRadius="12" BorderBrush="#E2E8F0" 
                            BorderThickness="1" Margin="0,0,0,8" Padding="2" 
                            Effect="{StaticResource CardShadow}">
                        <Button x:Name="SheetStoreButton"
                                Style="{StaticResource SidebarSubActionButton}" 
                                Padding="12,10" HorizontalContentAlignment="Stretch">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="📋" Margin="0,0,10,0" FontSize="13"/>
                                <TextBlock Grid.Column="1" Text="SheetStore" FontSize="11" 
                                           FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                <Border Grid.Column="2" Background="#2563EB" CornerRadius="8" 
                                        Padding="6,2" VerticalAlignment="Center">
                                    <TextBlock Text="NEW" FontSize="8" FontWeight="Bold" Foreground="#FFFFFF"/>
                                </Border>
                            </Grid>
                        </Button>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <ControlTemplate.Triggers>
            <Trigger SourceName="SidebarToggle" Property="IsChecked" Value="True">
                <Setter TargetName="SidebarBorder" Property="Width" Value="0"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="FloatingExpandButtonTemplate" TargetType="ContentControl">
        <ToggleButton x:Name="ExpandToggle"
                      HorizontalAlignment="Left" 
                      VerticalAlignment="Top" 
                      Margin="16"
                      Style="{StaticResource ExpandArrowButtonStyle}"
                      Visibility="Collapsed"/>
    </ControlTemplate>

</ResourceDictionary>